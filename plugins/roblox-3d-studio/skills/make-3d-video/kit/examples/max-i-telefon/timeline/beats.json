[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 0.7,
  "text": "Это Макс.",
  "end": 1.09
 },
 {
  "i": 1,
  "start": 1.09,
  "speechStart": 1.24,
  "speechEnd": 3.24,
  "text": "Обычный день, обычный парк.",
  "end": 3.09
 },
 {
  "i": 2,
  "start": 3.09,
  "speechStart": 3.24,
  "speechEnd": 5.42,
  "text": "Но сегодня Макс встретит Лили.",
  "end": 5.79
 },
 {
  "i": 3,
  "start": 5.79,
  "speechStart": 5.94,
  "speechEnd": 7.44,
  "text": "Она машет ему рукой.",
  "end": 7.89
 },
 {
  "i": 4,
  "start": 7.89,
  "speechStart": 8.04,
  "speechEnd": 9.6,
  "text": "И тут появляется Бекон.",
  "end": 10.05
 },
 {
  "i": 5,
  "start": 10.05,
  "speechStart": 10.2,
  "speechEnd": 12.5,
  "text": "Он хватает телефон Лили и убегает!",
  "end": 13.01
 },
 {
  "i": 6,
  "start": 13.01,
  "speechStart": 13.16,
  "speechEnd": 14.95,
  "text": "Макс бросается в погоню.",
  "end": 14.8
 },
 {
  "i": 7,
  "start": 14.8,
  "speechStart": 14.95,
  "speechEnd": 16.62,
  "text": "Прыжок через скамейку!",
  "end": 16.47
 },
 {
  "i": 8,
  "start": 16.47,
  "speechStart": 16.62,
  "speechEnd": 19.46,
  "text": "Бекон оборачивается. Бам!",
  "end": 19.31
 },
 {
  "i": 9,
  "start": 19.31,
  "speechStart": 19.46,
  "speechEnd": 22.58,
  "text": "Один удар, и хулиган летит в траву.",
  "end": 23.01
 },
 {
  "i": 10,
  "start": 23.01,
  "speechStart": 23.16,
  "speechEnd": 24.46,
  "text": "Телефон снова у Лили.",
  "end": 24.31
 },
 {
  "i": 11,
  "start": 24.31,
  "speechStart": 24.46,
  "speechEnd": 26.66,
  "text": "Друзья празднуют победу!",
  "end": 28.16
 }
]