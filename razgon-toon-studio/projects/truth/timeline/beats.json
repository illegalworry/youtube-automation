[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 3.34,
  "text": "Начальник спрашивает, как тебе его презентация? Мильярик?",
  "end": 3.61
 },
 {
  "i": 1,
  "start": 3.61,
  "speechStart": 3.76,
  "speechEnd": 5.92,
  "text": "И слово нормально застряла в горле.",
  "end": 6.13
 },
 {
  "i": 2,
  "start": 6.13,
  "speechStart": 6.28,
  "speechEnd": 8.5,
  "text": "Ты пытаешь о соврать, а выходит и исповедь.",
  "end": 8.79
 },
 {
  "i": 3,
  "start": 8.79,
  "speechStart": 8.94,
  "speechEnd": 11.42,
  "text": "Это не странность, это отключенная функция.",
  "end": 11.81
 },
 {
  "i": 4,
  "start": 11.81,
  "speechStart": 11.96,
  "speechEnd": 14.34,
  "text": "Мозг тратит на ложь в пять раз больше времени.",
  "end": 14.63
 },
 {
  "i": 5,
  "start": 14.63,
  "speechStart": 14.78,
  "speechEnd": 16.08,
  "text": "Сегодня этот шаг выключили.",
  "end": 16.39
 },
 {
  "i": 6,
  "start": 16.39,
  "speechStart": 16.54,
  "speechEnd": 19.0,
  "text": "Мрета спрашивает, ты ведь не злишься на меня.",
  "end": 19.37
 },
 {
  "i": 7,
  "start": 19.37,
  "speechStart": 19.52,
  "speechEnd": 21.46,
  "text": "Ты открываешь рот и вдруг...",
  "end": 22.96
 }
]