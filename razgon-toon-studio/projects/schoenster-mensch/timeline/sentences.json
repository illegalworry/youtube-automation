[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.06,
  "text": "Du steigst in den Bus."
 },
 {
  "i": 1,
  "start": 1.74,
  "end": 2.98,
  "text": "Das Gespräch verstummt."
 },
 {
  "i": 2,
  "start": 3.38,
  "end": 5.0,
  "text": "Der Fahrer vergisst zu blinken."
 },
 {
  "i": 3,
  "start": 5.44,
  "end": 6.96,
  "text": "Ein Kind lässt sein Eis fallen."
 },
 {
  "i": 4,
  "start": 7.54,
  "end": 8.56,
  "text": "Und start dich an."
 },
 {
  "i": 5,
  "start": 9.1,
  "end": 10.22,
  "text": "Ein Fremder springt auf."
 },
 {
  "i": 6,
  "start": 10.68,
  "end": 12.0,
  "text": "Erbietet dir seinen Platz an."
 },
 {
  "i": 7,
  "start": 12.42,
  "end": 13.84,
  "text": "Du hast noch nicht mal Hallo gesagt."
 },
 {
  "i": 8,
  "start": 14.5,
  "end": 16.68,
  "text": "In der Bäckerei bestellst du zwei Brötchen."
 },
 {
  "i": 9,
  "start": 17.08,
  "end": 18.92,
  "text": "Die Verkäuferin packt drei ein."
 },
 {
  "i": 10,
  "start": 19.36,
  "end": 20.16,
  "text": "Und kassiert nichts."
 },
 {
  "i": 11,
  "start": 20.7,
  "end": 21.24,
  "text": "Dein Kaffee?"
 },
 {
  "i": 12,
  "start": 21.72,
  "end": 22.22,
  "text": "Gratis."
 },
 {
  "i": 13,
  "start": 22.58,
  "end": 24.68,
  "text": "Dein Bus wartet extra auf dich."
 },
 {
  "i": 14,
  "start": 25.18,
  "end": 28.3,
  "text": "Ein normaler Mensch wird in einer Zehntelsekunde eingeschätzt."
 },
 {
  "i": 15,
  "start": 28.3,
  "end": 31.0,
  "text": "Das zeigten Willis und Todorov 2006."
 },
 {
  "i": 16,
  "start": 31.6,
  "end": 31.82,
  "text": "Du?"
 },
 {
  "i": 17,
  "start": 32.12,
  "end": 34.26,
  "text": "Du wirst in dieser Zeit bewundert."
 },
 {
  "i": 18,
  "start": 34.86,
  "end": 35.64,
  "text": "Hier ist die Regel."
 },
 {
  "i": 19,
  "start": 36.12,
  "end": 37.94,
  "text": "Dein Gesicht öffnet jede Tür."
 },
 {
  "i": 20,
  "start": 38.38,
  "end": 39.78,
  "text": "Aber es beweist nichts."
 },
 {
  "i": 21,
  "start": 40.26,
  "end": 41.02,
  "text": "Nicht dein Können."
 },
 {
  "i": 22,
  "start": 41.24,
  "end": 42.28,
  "text": "Nicht deine Ehrlichkeit."
 },
 {
  "i": 23,
  "start": 42.64,
  "end": 43.78,
  "text": "Nicht die Wahrheit."
 },
 {
  "i": 24,
  "start": 44.18,
  "end": 45.02,
  "text": "Alle glauben dir."
 },
 {
  "i": 25,
  "start": 45.5,
  "end": 47.22,
  "text": "Aber Glauben ist kein Beweis."
 },
 {
  "i": 26,
  "start": 47.74,
  "end": 50.42,
  "text": "Also was, wenn du der schönste Mensch der Welt wärst?"
 },
 {
  "i": 27,
  "start": 50.7,
  "end": 52.16,
  "text": "Und was, wenn das nicht reicht?"
 },
 {
  "i": 28,
  "start": 52.7,
  "end": 54.96,
  "text": "Plus, dein Lehrer gibt dir eine Eins."
 },
 {
  "i": 29,
  "start": 55.36,
  "end": 57.04,
  "text": "Dein Aufsatz hat vier Fehler."
 },
 {
  "i": 30,
  "start": 57.04,
  "end": 60.58,
  "text": "Minus, du fragst dich, ob du sie verdient hast."
 },
 {
  "i": 31,
  "start": 61.02,
  "end": 63.08,
  "text": "Forscher nennen das den Halo Effekt."
 },
 {
  "i": 32,
  "start": 63.42,
  "end": 66.38,
  "text": "Schöne Menschen wirken klüger, netter, ehrlicher."
 },
 {
  "i": 33,
  "start": 66.8,
  "end": 67.94,
  "text": "Auch wenn sie es nicht sind."
 },
 {
  "i": 34,
  "start": 68.4,
  "end": 69.8,
  "text": "Dann kommt der Bewerbungstag."
 },
 {
  "i": 35,
  "start": 70.28,
  "end": 71.18,
  "text": "Du betrittst das Büro."
 },
 {
  "i": 36,
  "start": 71.62,
  "end": 72.78,
  "text": "Der Chef lächelt schon."
 },
 {
  "i": 37,
  "start": 73.14,
  "end": 74.94,
  "text": "Er hat deinen Lebenslauf noch nicht gelesen."
 },
 {
  "i": 38,
  "start": 75.32,
  "end": 76.58,
  "text": "Die Stelle gehört dir."
 },
 {
  "i": 39,
  "start": 77.02,
  "end": 78.92,
  "text": "Leo, dein neuer Kollege, flüstert."
 },
 {
  "i": 40,
  "start": 79.36,
  "end": 80.26,
  "text": "Wie machst du das?"
 },
 {
  "i": 41,
  "start": 80.74,
  "end": 81.88,
  "text": "Du zuckst mit den Schultern."
 },
 {
  "i": 42,
  "start": 82.28,
  "end": 83.24,
  "text": "Ich hab nichts gemacht."
 },
 {
  "i": 43,
  "start": 83.7,
  "end": 85.96,
  "text": "Im Restaurant bekommst du den besten Tisch."
 },
 {
  "i": 44,
  "start": 85.96,
  "end": 87.52,
  "text": "Und ein Dessert aufs Haus."
 },
 {
  "i": 45,
  "start": 88.08,
  "end": 89.94,
  "text": "Der Kellner stolpert über Jonas Fuß."
 },
 {
  "i": 46,
  "start": 90.4,
  "end": 91.72,
  "text": "Und entschuldigt sich bei dir."
 },
 {
  "i": 47,
  "start": 92.14,
  "end": 94.78,
  "text": "Jonas, dein bester Freund, hebt die Augenbrauen."
 },
 {
  "i": 48,
  "start": 95.22,
  "end": 96.7,
  "text": "Hallo, das war mein Fuß."
 },
 {
  "i": 49,
  "start": 97.32,
  "end": 99.0,
  "text": "Dann dein erstes Foto im Netz."
 },
 {
  "i": 50,
  "start": 99.4,
  "end": 101.16,
  "text": "Um acht Uhr abends postest du es."
 },
 {
  "i": 51,
  "start": 101.44,
  "end": 103.56,
  "text": "Um neun hast du hunderttausend Likes."
 },
 {
  "i": 52,
  "start": 103.94,
  "end": 105.6,
  "text": "Um Mitternacht eine Million."
 },
 {
  "i": 53,
  "start": 106.16,
  "end": 107.3,
  "text": "Dein Akku leer."
 },
 {
  "i": 54,
  "start": 107.78,
  "end": 109.1,
  "text": "Deine Mailbox voll."
 },
 {
  "i": 55,
  "start": 109.52,
  "end": 111.26,
  "text": "Plus, dein Konto füllt sich."
 },
 {
  "i": 56,
  "start": 111.62,
  "end": 113.96,
  "text": "Minus, keiner fragt, was du denkst."
 },
 {
  "i": 57,
  "start": 113.96,
  "end": 116.06,
  "text": "Auf der Straße bleibt ein Mann stehen."
 },
 {
  "i": 58,
  "start": 116.44,
  "end": 118.14,
  "text": "Er filmt dich, ohne zu fragen."
 },
 {
  "i": 59,
  "start": 118.7,
  "end": 119.34,
  "text": "Dann eine Frau."
 },
 {
  "i": 60,
  "start": 119.8,
  "end": 120.6,
  "text": "Dann eine Gruppe."
 },
 {
  "i": 61,
  "start": 120.98,
  "end": 123.34,
  "text": "Nach einer Minute sind es 30 Handys."
 },
 {
  "i": 62,
  "start": 123.62,
  "end": 124.96,
  "text": "Und immer dieselben Sätze."
 },
 {
  "i": 63,
  "start": 125.38,
  "end": 126.52,
  "text": "Du bist wunderschön."
 },
 {
  "i": 64,
  "start": 126.88,
  "end": 127.48,
  "text": "Du bist perfekt."
 },
 {
  "i": 65,
  "start": 128.04,
  "end": 128.9,
  "text": "Du bist..."
 },
 {
  "i": 66,
  "start": 128.9,
  "end": 129.16,
  "text": "Ja."
 },
 {
  "i": 67,
  "start": 129.58,
  "end": 130.1,
  "text": "Was eigentlich?"
 },
 {
  "i": 68,
  "start": 130.72,
  "end": 133.88,
  "text": "Ein Spaziergang im Park dauert normalerweise 30 Minuten."
 },
 {
  "i": 69,
  "start": 134.36,
  "end": 135.9,
  "text": "Bei dir 3 Stunden."
 },
 {
  "i": 70,
  "start": 136.34,
  "end": 137.1,
  "text": "Wegen Selfies."
 },
 {
  "i": 71,
  "start": 137.48,
  "end": 139.94,
  "text": "Minus, du kannst dich nirgends mehr verstecken."
 },
 {
  "i": 72,
  "start": 140.36,
  "end": 142.76,
  "text": "Aber richtig verrückt wird es in Paris."
 },
 {
  "i": 73,
  "start": 142.76,
  "end": 144.16,
  "text": "Eine Modenschau."
 },
 {
  "i": 74,
  "start": 144.46,
  "end": 145.42,
  "text": "200 Plätze."
 },
 {
  "i": 75,
  "start": 145.76,
  "end": 147.62,
  "text": "2000 Menschen wollen hinein."
 },
 {
  "i": 76,
  "start": 147.9,
  "end": 149.2,
  "text": "Du gehst über den Laufsteg."
 },
 {
  "i": 77,
  "start": 149.54,
  "end": 150.26,
  "text": "20 Meter."
 },
 {
  "i": 78,
  "start": 150.68,
  "end": 151.7,
  "text": "30 Sekunden."
 },
 {
  "i": 79,
  "start": 152.04,
  "end": 154.68,
  "text": "Ein Mensch blinzelt etwa 15 Mal pro Minute."
 },
 {
  "i": 80,
  "start": 155.12,
  "end": 156.5,
  "text": "Im Saal blinzelt keiner."
 },
 {
  "i": 81,
  "start": 156.94,
  "end": 158.92,
  "text": "Sogar der Fotograf vergisst zu knipsen."
 },
 {
  "i": 82,
  "start": 159.28,
  "end": 160.04,
  "text": "Am nächsten Morgen?"
 },
 {
  "i": 83,
  "start": 160.44,
  "end": 162.2,
  "text": "Dein Foto läuft in 100 Ländern."
 },
 {
  "i": 84,
  "start": 162.6,
  "end": 164.58,
  "text": "Eine Sängerin will dich in ihrem Video."
 },
 {
  "i": 85,
  "start": 165.12,
  "end": 167.44,
  "text": "Ein Konzern will dein Gesicht auf Plakaten."
 },
 {
  "i": 86,
  "start": 167.86,
  "end": 169.08,
  "text": "20 Meter hoch."
 },
 {
  "i": 87,
  "start": 169.5,
  "end": 170.06,
  "text": "Nur du."
 },
 {
  "i": 88,
  "start": 170.52,
  "end": 171.58,
  "text": "Und dein Lächeln."
 },
 {
  "i": 89,
  "start": 171.58,
  "end": 173.32,
  "text": "Und es gibt einen Preis."
 },
 {
  "i": 90,
  "start": 173.96,
  "end": 174.66,
  "text": "Den sieht keiner."
 },
 {
  "i": 91,
  "start": 175.18,
  "end": 176.86,
  "text": "Du hörst nie wieder die Wahrheit."
 },
 {
  "i": 92,
  "start": 177.24,
  "end": 178.38,
  "text": "Niemand widerspricht dir."
 },
 {
  "i": 93,
  "start": 178.7,
  "end": 180.44,
  "text": "Niemand sagt, das war schlecht."
 },
 {
  "i": 94,
  "start": 181.12,
  "end": 181.42,
  "text": "Der Grund?"
 },
 {
  "i": 95,
  "start": 181.96,
  "end": 184.1,
  "text": "Dein Anblick aktiviert ihr Belohnungssystem."
 },
 {
  "i": 96,
  "start": 184.66,
  "end": 185.5,
  "text": "Sie wollen dir gefallen."
 },
 {
  "i": 97,
  "start": 186.08,
  "end": 188.14,
  "text": "Du bekommst Applaus statt Ehrlichkeit."
 },
 {
  "i": 98,
  "start": 188.5,
  "end": 191.12,
  "text": "Ein ganzes Jahr ohne ein einziges Nein."
 },
 {
  "i": 99,
  "start": 191.64,
  "end": 194.58,
  "text": "Und plötzlich fragst du dich, was an dir wirklich zählt."
 },
 {
  "i": 100,
  "start": 195.1,
  "end": 195.88,
  "text": "Wer mag dich?"
 },
 {
  "i": 101,
  "start": 196.26,
  "end": 197.4,
  "text": "Und wer nur dein Gesicht?"
 },
 {
  "i": 102,
  "start": 197.96,
  "end": 200.62,
  "text": "Wer nie Fehler gezeigt bekommt, lernt nie."
 },
 {
  "i": 103,
  "start": 200.62,
  "end": 203.36,
  "text": "Das macht einsam und gefährlich."
 },
 {
  "i": 104,
  "start": 203.84,
  "end": 204.96,
  "text": "Nur einer ist anders."
 },
 {
  "i": 105,
  "start": 205.74,
  "end": 208.34,
  "text": "Jonas, dein bester Freund seit der ersten Klasse."
 },
 {
  "i": 106,
  "start": 208.84,
  "end": 210.5,
  "text": "Jeden Morgen klopft er an deine Tür."
 },
 {
  "i": 107,
  "start": 210.88,
  "end": 212.68,
  "text": "Dreimal kurz, einmal lang."
 },
 {
  "i": 108,
  "start": 213.08,
  "end": 214.48,
  "text": "Dann sagt er immer dasselbe."
 },
 {
  "i": 109,
  "start": 214.86,
  "end": 216.34,
  "text": "Du siehst furchtbar aus."
 },
 {
  "i": 110,
  "start": 216.8,
  "end": 217.32,
  "text": "Er lügt."
 },
 {
  "i": 111,
  "start": 217.76,
  "end": 219.28,
  "text": "Und genau das liebst du."
 },
 {
  "i": 112,
  "start": 219.62,
  "end": 222.12,
  "text": "Bei ihm ist dein Gesicht nur ein Gesicht."
 },
 {
  "i": 113,
  "start": 222.62,
  "end": 224.1,
  "text": "Er streitet mit dir über Pizza."
 },
 {
  "i": 114,
  "start": 224.56,
  "end": 225.86,
  "text": "Er lacht über deine Witze."
 },
 {
  "i": 115,
  "start": 226.18,
  "end": 227.74,
  "text": "Über die schlechten noch lauter."
 },
 {
  "i": 116,
  "start": 227.74,
  "end": 230.8,
  "text": "Sam, hast du heute wieder nichts gelernt?"
 },
 {
  "i": 117,
  "start": 231.28,
  "end": 233.7,
  "text": "Du lachst zum ersten Mal seit Wochen."
 },
 {
  "i": 118,
  "start": 234.2,
  "end": 236.98,
  "text": "Er ist der Einzige der nie nach deinem Foto fragt."
 },
 {
  "i": 119,
  "start": 237.38,
  "end": 238.84,
  "text": "Dann kommt Herr Brandt."
 },
 {
  "i": 120,
  "start": 238.9,
  "end": 240.82,
  "text": "Ihm gehört die größte Agentur der Stadt."
 },
 {
  "i": 121,
  "start": 241.3,
  "end": 242.02,
  "text": "Sein Angebot?"
 },
 {
  "i": 122,
  "start": 242.38,
  "end": 243.5,
  "text": "10 Millionen Euro."
 },
 {
  "i": 123,
  "start": 243.9,
  "end": 244.48,
  "text": "3 Jahre."
 },
 {
  "i": 124,
  "start": 244.96,
  "end": 246.54,
  "text": "Dein Gesicht auf jedem Plakat."
 },
 {
  "i": 125,
  "start": 247.04,
  "end": 248.28,
  "text": "Es gibt nur einen Haken."
 },
 {
  "i": 126,
  "start": 248.76,
  "end": 250.68,
  "text": "Jonas, Brandt beschuldigt ihn."
 },
 {
  "i": 127,
  "start": 251.1,
  "end": 252.3,
  "text": "Der Diebstahl im Studio."
 },
 {
  "i": 128,
  "start": 252.7,
  "end": 253.4,
  "text": "Um Mitternacht."
 },
 {
  "i": 129,
  "start": 253.84,
  "end": 255.04,
  "text": "50 .000 Euro."
 },
 {
  "i": 130,
  "start": 255.46,
  "end": 255.66,
  "text": "Weg."
 },
 {
  "i": 131,
  "start": 255.66,
  "end": 257.26,
  "text": "Du weißt die Wahrheit."
 },
 {
  "i": 132,
  "start": 257.56,
  "end": 258.56,
  "text": "Jonas war bei dir."
 },
 {
  "i": 133,
  "start": 259.0,
  "end": 259.84,
  "text": "Die ganze Nacht."
 },
 {
  "i": 134,
  "start": 260.3,
  "end": 261.1,
  "text": "Die Presse wartet."
 },
 {
  "i": 135,
  "start": 261.72,
  "end": 262.44,
  "text": "Liveübertragung."
 },
 {
  "i": 136,
  "start": 262.72,
  "end": 264.24,
  "text": "20 Millionen Zuschauer."
 },
 {
  "i": 137,
  "start": 264.58,
  "end": 265.82,
  "text": "Noch 60 Sekunden."
 },
 {
  "i": 138,
  "start": 266.12,
  "end": 266.88,
  "text": "Brandt flüstert."
 },
 {
  "i": 139,
  "start": 267.3,
  "end": 268.82,
  "text": "Sag, du hast Jonas gesehen."
 },
 {
  "i": 140,
  "start": 269.18,
  "end": 269.68,
  "text": "Mit dem Geld."
 },
 {
  "i": 141,
  "start": 270.12,
  "end": 270.82,
  "text": "Dir glaubt jeder."
 },
 {
  "i": 142,
  "start": 271.3,
  "end": 271.86,
  "text": "Er hat recht."
 },
 {
  "i": 143,
  "start": 272.42,
  "end": 273.52,
  "text": "Das ist das Schlimmste."
 },
 {
  "i": 144,
  "start": 273.98,
  "end": 275.6,
  "text": "70 Herzschläge pro Minute."
 },
 {
  "i": 145,
  "start": 276.08,
  "end": 277.7,
  "text": "Du spürst jeden Einzelnen."
 },
 {
  "i": 146,
  "start": 278.14,
  "end": 279.82,
  "text": "Dein Gesicht öffnet jede Tür."
 },
 {
  "i": 147,
  "start": 280.2,
  "end": 281.72,
  "text": "Doch es beweist nichts."
 },
 {
  "i": 148,
  "start": 282.28,
  "end": 283.98,
  "text": "Der Vertrag oder Jonas."
 },
 {
  "i": 149,
  "start": 283.98,
  "end": 285.96,
  "text": "Schöne Gesichter gibt es viele."
 },
 {
  "i": 150,
  "start": 286.32,
  "end": 288.16,
  "text": "Einen Jonas gibt es nur einmal."
 },
 {
  "i": 151,
  "start": 288.72,
  "end": 289.66,
  "text": "Du gehst auf die Bühne."
 },
 {
  "i": 152,
  "start": 290.04,
  "end": 291.02,
  "text": "Dein Mund ist trocken."
 },
 {
  "i": 153,
  "start": 291.38,
  "end": 292.1,
  "text": "Brandt lächelt."
 },
 {
  "i": 154,
  "start": 292.5,
  "end": 293.54,
  "text": "Er erwartet die Lüge."
 },
 {
  "i": 155,
  "start": 293.94,
  "end": 295.28,
  "text": "Du sagst die Wahrheit."
 },
 {
  "i": 156,
  "start": 295.68,
  "end": 296.58,
  "text": "Jonas war bei mir."
 },
 {
  "i": 157,
  "start": 296.94,
  "end": 298.5,
  "text": "Meine Türkamera hat es aufgenommen."
 },
 {
  "i": 158,
  "start": 298.96,
  "end": 299.86,
  "text": "Du hebst dein Handy."
 },
 {
  "i": 159,
  "start": 300.3,
  "end": 301.1,
  "text": "Die Aufnahme läuft."
 },
 {
  "i": 160,
  "start": 301.58,
  "end": 303.04,
  "text": "23 Uhr 41."
 },
 {
  "i": 161,
  "start": 303.66,
  "end": 304.34,
  "text": "Dreimal kurz."
 },
 {
  "i": 162,
  "start": 304.86,
  "end": 305.4,
  "text": "Einmal lang."
 },
 {
  "i": 163,
  "start": 305.84,
  "end": 307.04,
  "text": "Dann eine leise Stimme."
 },
 {
  "i": 164,
  "start": 307.46,
  "end": 308.74,
  "text": "Du siehst furchtbar aus."
 },
 {
  "i": 165,
  "start": 309.14,
  "end": 311.32,
  "text": "Und er bleibt bis 6 Uhr morgens."
 },
 {
  "i": 166,
  "start": 311.76,
  "end": 312.74,
  "text": "Der Saal wird still."
 },
 {
  "i": 167,
  "start": 312.74,
  "end": 314.84,
  "text": "20 Millionen Menschen hören."
 },
 {
  "i": 168,
  "start": 315.42,
  "end": 315.92,
  "text": "Einen Freund."
 },
 {
  "i": 169,
  "start": 316.62,
  "end": 317.8,
  "text": "Dann bricht Applaus los."
 },
 {
  "i": 170,
  "start": 318.28,
  "end": 319.12,
  "text": "Brandt wird blass."
 },
 {
  "i": 171,
  "start": 319.54,
  "end": 320.56,
  "text": "Der Vertrag platzt."
 },
 {
  "i": 172,
  "start": 320.96,
  "end": 321.62,
  "text": "10 Millionen?"
 },
 {
  "i": 173,
  "start": 322.16,
  "end": 322.4,
  "text": "Weg!"
 },
 {
  "i": 174,
  "start": 322.88,
  "end": 324.22,
  "text": "Du hättest Jonas opfern können."
 },
 {
  "i": 175,
  "start": 324.58,
  "end": 325.3,
  "text": "Alles behalten."
 },
 {
  "i": 176,
  "start": 325.72,
  "end": 327.36,
  "text": "Doch dann wärst du wie Brandt."
 },
 {
  "i": 177,
  "start": 327.6,
  "end": 328.76,
  "text": "Draußen wartet Jonas."
 },
 {
  "i": 178,
  "start": 329.26,
  "end": 329.7,
  "text": "Er grinst."
 },
 {
  "i": 179,
  "start": 330.22,
  "end": 331.7,
  "text": "Du siehst furchtbar aus."
 },
 {
  "i": 180,
  "start": 332.06,
  "end": 333.3,
  "text": "Und du lachst."
 },
 {
  "i": 181,
  "start": 333.48,
  "end": 334.36,
  "text": "Richtig laut."
 },
 {
  "i": 182,
  "start": 334.96,
  "end": 336.12,
  "text": "Und endlich echt."
 },
 {
  "i": 183,
  "start": 336.76,
  "end": 338.8,
  "text": "Er sagt, das war leichtsinnig."
 },
 {
  "i": 184,
  "start": 339.16,
  "end": 340.7,
  "text": "Endlich widerspricht er jemand."
 },
 {
  "i": 185,
  "start": 340.7,
  "end": 343.44,
  "text": "Und es fühlt sich wunderbar an."
 },
 {
  "i": 186,
  "start": 344.02,
  "end": 345.42,
  "text": "Schöne Gesichter gibt es viele."
 },
 {
  "i": 187,
  "start": 345.84,
  "end": 347.74,
  "text": "Einen Jonas gibt es nur einmal."
 },
 {
  "i": 188,
  "start": 348.44,
  "end": 349.82,
  "text": "Und was ist davon wahr?"
 },
 {
  "i": 189,
  "start": 350.4,
  "end": 352.44,
  "text": "Schönheit öffnet tatsächlich Türen."
 },
 {
  "i": 190,
  "start": 352.9,
  "end": 357.38,
  "text": "1972 zeigten Dion, Berscheid und Walster genau das."
 },
 {
  "i": 191,
  "start": 357.88,
  "end": 360.8,
  "text": "Attraktive Menschen gelten als klüger und freundlicher."
 },
 {
  "i": 192,
  "start": 361.32,
  "end": 366.68,
  "text": "1990 fanden Langlois und Rockmann, gemittelte Gesichter wirken anziehender."
 },
 {
  "i": 193,
  "start": 367.26,
  "end": 371.08,
  "text": "Für den goldenen Schnitt als Schönheitsformel gibt es keinen sicheren Beleg."
 },
 {
  "i": 194,
  "start": 371.54,
  "end": 373.78,
  "text": "Und ein Gesicht beweist keine Ehrlichkeit."
 },
 {
  "i": 195,
  "start": 374.16,
  "end": 375.56,
  "text": "Es macht dich nur glaubwürdiger."
 },
 {
  "i": 196,
  "start": 375.98,
  "end": 377.36,
  "text": "Der Rest ist Fiktion."
 },
 {
  "i": 197,
  "start": 377.84,
  "end": 380.18,
  "text": "Aber was bedeutet eigentlich schön?"
 },
 {
  "i": 198,
  "start": 380.82,
  "end": 382.18,
  "text": "Nachts vibriert dein Handy."
 },
 {
  "i": 199,
  "start": 382.68,
  "end": 383.42,
  "text": "Unbekannte Nummer."
 },
 {
  "i": 200,
  "start": 383.88,
  "end": 384.94,
  "text": "Eine Stimme flüstert."
 },
 {
  "i": 201,
  "start": 385.44,
  "end": 385.98,
  "text": "Gut gemacht."
 },
 {
  "i": 202,
  "start": 386.6,
  "end": 388.56,
  "text": "Aber du bist nicht der Einzige mit diesem Gesicht."
 },
 {
  "i": 203,
  "start": 389.22,
  "end": 389.92,
  "text": "Was denkst du?"
 },
 {
  "i": 204,
  "start": 390.28,
  "end": 391.48,
  "text": "Schreib es uns in die Kommentare."
 },
 {
  "i": 205,
  "start": 392.1,
  "end": 394.9,
  "text": "Und sag uns, welche Superkraft wir als nächstes machen sollen."
 },
 {
  "i": 206,
  "start": 395.38,
  "end": 396.18,
  "text": "Lass ein Like da."
 },
 {
  "i": 207,
  "start": 396.64,
  "end": 398.18,
  "text": "Und abonniere für Teil 2."
 }
]