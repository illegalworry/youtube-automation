{
  "name": "cartoon-shorts",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/bridge-stills.mjs",
    "render": "remotion render src/index.ts BridgeShort out/bridge/video.mp4 --codec h264 --crf 18",
    "check": "tsc --noEmit",
    "render:720": "remotion render src/index.ts BridgeShort out/bridge/video_720.mp4 --codec h264 --crf 18 --scale 0.6667 --props={\"post\":{\"dpr\":0.6667}}"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/three": "4.0.539",
    "@types/three": "0.186.0",
    "postprocessing": "6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
