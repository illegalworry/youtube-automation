[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.98,
  "text": "Your alarm rings, you hit it before the second beep."
 },
 {
  "i": 1,
  "start": 3.38,
  "end": 4.66,
  "text": "Mia drops onto your couch."
 },
 {
  "i": 2,
  "start": 5.32,
  "end": 7.9,
  "text": "Hey, what was I wearing on our first day of sixth grade?"
 },
 {
  "i": 3,
  "start": 8.46,
  "end": 10.76,
  "text": "Easy, green raincoat, torn left sleeve."
 },
 {
  "i": 4,
  "start": 11.34,
  "end": 12.26,
  "text": "She stares at you."
 },
 {
  "i": 5,
  "start": 12.62,
  "end": 13.92,
  "text": "What was the weather on my birthday?"
 },
 {
  "i": 6,
  "start": 14.56,
  "end": 17.04,
  "text": "Rainy, 14 degrees, wind from the west."
 },
 {
  "i": 7,
  "start": 17.62,
  "end": 19.76,
  "text": "She checks her phone and goes quiet."
 },
 {
  "i": 8,
  "start": 20.24,
  "end": 24.06,
  "text": "At school, your teacher asks for page 214, line three."
 },
 {
  "i": 9,
  "start": 24.4,
  "end": 25.82,
  "text": "You say it word for word."
 },
 {
  "i": 10,
  "start": 26.14,
  "end": 28.0,
  "text": "A tourist asks for the bus timetable."
 },
 {
  "i": 11,
  "start": 28.48,
  "end": 29.24,
  "text": "You recite it."
 },
 {
  "i": 12,
  "start": 29.24,
  "end": 31.02,
  "text": "Every stop, every minute."
 },
 {
  "i": 13,
  "start": 31.38,
  "end": 33.76,
  "text": "Not because you studied, because you saw it once."
 },
 {
  "i": 14,
  "start": 34.56,
  "end": 35.32,
  "text": "Mia shakes her head."
 },
 {
  "i": 15,
  "start": 35.78,
  "end": 36.96,
  "text": "Dude, that's creepy."
 },
 {
  "i": 16,
  "start": 37.6,
  "end": 39.22,
  "text": "Fine, but where are your keys?"
 },
 {
  "i": 17,
  "start": 39.86,
  "end": 41.52,
  "text": "You have no idea."
 },
 {
  "i": 18,
  "start": 41.94,
  "end": 42.92,
  "text": "You never looked at them."
 },
 {
  "i": 19,
  "start": 43.2,
  "end": 47.82,
  "text": "Your name is Max, you're 17, and your memory just became perfect."
 },
 {
  "i": 20,
  "start": 48.42,
  "end": 50.94,
  "text": "Most people hold about seven things in their head at once."
 },
 {
  "i": 21,
  "start": 51.46,
  "end": 52.88,
  "text": "You, 7 ,000."
 },
 {
  "i": 22,
  "start": 53.3,
  "end": 55.74,
  "text": "A normal brain forgets much of a lecture by tomorrow."
 },
 {
  "i": 23,
  "start": 56.24,
  "end": 57.82,
  "text": "You, you forget nothing."
 },
 {
  "i": 24,
  "start": 57.82,
  "end": 60.34,
  "text": "Everything you notice is saved forever."
 },
 {
  "i": 25,
  "start": 60.9,
  "end": 64.04,
  "text": "Sounds, smells, feelings, but there's one rule."
 },
 {
  "i": 26,
  "start": 64.52,
  "end": 67.1,
  "text": "Your memory lives in your head and only there."
 },
 {
  "i": 27,
  "start": 67.48,
  "end": 70.64,
  "text": "You can't copy it, you can't lend it, you can't prove it."
 },
 {
  "i": 28,
  "start": 70.96,
  "end": 73.64,
  "text": "So what if you had a perfect memory forever?"
 },
 {
  "i": 29,
  "start": 74.68,
  "end": 75.52,
  "text": "Monday, pop quiz."
 },
 {
  "i": 30,
  "start": 76.06,
  "end": 77.74,
  "text": "You flip through the textbook in your mind."
 },
 {
  "i": 31,
  "start": 78.06,
  "end": 82.26,
  "text": "The margin doodle, the coffee stain, perfect score in four minutes."
 },
 {
  "i": 32,
  "start": 82.88,
  "end": 84.4,
  "text": "Mia whispers, is that cheating?"
 },
 {
  "i": 33,
  "start": 84.94,
  "end": 87.34,
  "text": "It's reading, very fast reading."
 },
 {
  "i": 34,
  "start": 87.34,
  "end": 90.16,
  "text": "Saturday party, 300 people."
 },
 {
  "i": 35,
  "start": 90.6,
  "end": 92.1,
  "text": "You greet everyone by name."
 },
 {
  "i": 36,
  "start": 92.68,
  "end": 93.52,
  "text": "Jake pulls you aside."
 },
 {
  "i": 37,
  "start": 94.04,
  "end": 95.78,
  "text": "How, how do you know my dog's name?"
 },
 {
  "i": 38,
  "start": 96.24,
  "end": 98.96,
  "text": "You heard it once, in 2019, at a bus stop."
 },
 {
  "i": 39,
  "start": 99.52,
  "end": 100.76,
  "text": "Jake backs away slowly."
 },
 {
  "i": 40,
  "start": 101.54,
  "end": 102.48,
  "text": "Plus, new cities."
 },
 {
  "i": 41,
  "start": 103.0,
  "end": 105.52,
  "text": "You walk a street once and never need a map again."
 },
 {
  "i": 42,
  "start": 106.1,
  "end": 107.56,
  "text": "Tourists follow you like ducklings."
 },
 {
  "i": 43,
  "start": 108.14,
  "end": 110.4,
  "text": "Plus, a car blows through a red light."
 },
 {
  "i": 44,
  "start": 110.7,
  "end": 112.54,
  "text": "You read the plate, seven characters."
 },
 {
  "i": 45,
  "start": 113.0,
  "end": 114.54,
  "text": "A police officer writes them down."
 },
 {
  "i": 46,
  "start": 114.96,
  "end": 116.22,
  "text": "Where, where were you standing?"
 },
 {
  "i": 47,
  "start": 116.22,
  "end": 118.52,
  "text": "Across the street, you only glanced."
 },
 {
  "i": 48,
  "start": 119.32,
  "end": 120.06,
  "text": "Plus, tests."
 },
 {
  "i": 49,
  "start": 120.92,
  "end": 125.72,
  "text": "Memory champions can memorize a shuffled deck in under 30 seconds, after years of training."
 },
 {
  "i": 50,
  "start": 126.2,
  "end": 128.62,
  "text": "You, one glance, 52 cards."
 },
 {
  "i": 51,
  "start": 129.14,
  "end": 129.38,
  "text": "Dr."
 },
 {
  "i": 52,
  "start": 129.58,
  "end": 130.46,
  "text": "Lee drops her clipboard."
 },
 {
  "i": 53,
  "start": 131.06,
  "end": 132.1,
  "text": "That's impossible."
 },
 {
  "i": 54,
  "start": 132.84,
  "end": 138.08,
  "text": "She scans your head, same brain, about 86 billion neurons, same as everyone's."
 },
 {
  "i": 55,
  "start": 138.32,
  "end": 141.44,
  "text": "Nothing special, except what yours refuse to drop."
 },
 {
  "i": 56,
  "start": 141.88,
  "end": 144.48,
  "text": "You try to forget one card, you can't."
 },
 {
  "i": 57,
  "start": 144.48,
  "end": 146.92,
  "text": "Plus, you read a French dictionary once."
 },
 {
  "i": 58,
  "start": 147.34,
  "end": 148.66,
  "text": "You can recite page 90."
 },
 {
  "i": 59,
  "start": 149.28,
  "end": 151.32,
  "text": "Minus, you still can't order a croissant."
 },
 {
  "i": 60,
  "start": 151.86,
  "end": 153.5,
  "text": "Remembering isn't understanding."
 },
 {
  "i": 61,
  "start": 154.22,
  "end": 155.2,
  "text": "Minus, arguments."
 },
 {
  "i": 62,
  "start": 155.92,
  "end": 157.88,
  "text": "Jake swears he never borrowed your pen."
 },
 {
  "i": 63,
  "start": 158.3,
  "end": 160.4,
  "text": "You give the date, the time, the color."
 },
 {
  "i": 64,
  "start": 160.78,
  "end": 161.82,
  "text": "The cap was chewed."
 },
 {
  "i": 65,
  "start": 162.38,
  "end": 164.4,
  "text": "Mutt, nobody likes a human receipt."
 },
 {
  "i": 66,
  "start": 165.22,
  "end": 166.14,
  "text": "Minus, clutter."
 },
 {
  "i": 67,
  "start": 166.66,
  "end": 168.26,
  "text": "You remember Jake's phone password."
 },
 {
  "i": 68,
  "start": 168.74,
  "end": 169.56,
  "text": "Mia's locker code."
 },
 {
  "i": 69,
  "start": 169.96,
  "end": 170.2,
  "text": "Dr."
 },
 {
  "i": 70,
  "start": 170.32,
  "end": 171.3,
  "text": "Lee's laptop login."
 },
 {
  "i": 71,
  "start": 171.8,
  "end": 173.28,
  "text": "You never wanted any of them."
 },
 {
  "i": 72,
  "start": 173.28,
  "end": 174.2,
  "text": "Awkward,"
 },
 {
  "i": 73,
  "start": 175.06,
  "end": 175.84,
  "text": "very awkward."
 },
 {
  "i": 74,
  "start": 176.6,
  "end": 177.72,
  "text": "Minus, promises."
 },
 {
  "i": 75,
  "start": 178.48,
  "end": 180.04,
  "text": "Mia once promised to call you back."
 },
 {
  "i": 76,
  "start": 180.44,
  "end": 182.04,
  "text": "She forgot, you didn't."
 },
 {
  "i": 77,
  "start": 182.38,
  "end": 185.58,
  "text": "You remember the date, the hour, her exact words."
 },
 {
  "i": 78,
  "start": 186.16,
  "end": 188.24,
  "text": "Why, why does that still sting?"
 },
 {
  "i": 79,
  "start": 188.8,
  "end": 190.02,
  "text": "Because it never got old."
 },
 {
  "i": 80,
  "start": 190.72,
  "end": 191.68,
  "text": "Minus, sleep."
 },
 {
  "i": 81,
  "start": 192.14,
  "end": 195.46,
  "text": "A normal brain replays the day at night and keeps the useful parts."
 },
 {
  "i": 82,
  "start": 195.86,
  "end": 200.52,
  "text": "Yours keeps everything, every conversation, every sound, on loop."
 },
 {
  "i": 83,
  "start": 200.52,
  "end": 203.42,
  "text": "You wake up tired, of course you do."
 },
 {
  "i": 84,
  "start": 203.82,
  "end": 205.18,
  "text": "Plus, homework excuses."
 },
 {
  "i": 85,
  "start": 205.84,
  "end": 207.4,
  "text": "Minus, you can't use any."
 },
 {
  "i": 86,
  "start": 207.78,
  "end": 209.4,
  "text": "Your mom asks if you cleaned your room."
 },
 {
  "i": 87,
  "start": 209.72,
  "end": 211.78,
  "text": "You remember her asking 11 times."
 },
 {
  "i": 88,
  "start": 212.2,
  "end": 214.7,
  "text": "You remember ignoring her 11 times."
 },
 {
  "i": 89,
  "start": 215.28,
  "end": 216.64,
  "text": "Busted, by yourself."
 },
 {
  "i": 90,
  "start": 217.2,
  "end": 219.56,
  "text": "By Friday, a local news crew is at your door."
 },
 {
  "i": 91,
  "start": 219.9,
  "end": 221.92,
  "text": "Your video gets two million views."
 },
 {
  "i": 92,
  "start": 222.52,
  "end": 223.12,
  "text": "Mia grins."
 },
 {
  "i": 93,
  "start": 223.46,
  "end": 224.1,
  "text": "You're famous!"
 },
 {
  "i": 94,
  "start": 224.6,
  "end": 226.12,
  "text": "Grandpa Leo wipes his glasses."
 },
 {
  "i": 95,
  "start": 226.64,
  "end": 227.56,
  "text": "That's nice, kid."
 },
 {
  "i": 96,
  "start": 227.96,
  "end": 230.72,
  "text": "And somewhere in the city, someone watches you twice."
 },
 {
  "i": 97,
  "start": 231.34,
  "end": 232.02,
  "text": "But here's the catch."
 },
 {
  "i": 98,
  "start": 232.5,
  "end": 234.36,
  "text": "A normal brain forgets on purpose."
 },
 {
  "i": 99,
  "start": 234.84,
  "end": 236.74,
  "text": "Forgetting is cleanup, not failure."
 },
 {
  "i": 100,
  "start": 237.12,
  "end": 239.32,
  "text": "It drops the details so patterns can show."
 },
 {
  "i": 101,
  "start": 239.6,
  "end": 242.62,
  "text": "You see every leaf and sometimes miss the forest."
 },
 {
  "i": 102,
  "start": 243.08,
  "end": 244.78,
  "text": "It's also how pain softens."
 },
 {
  "i": 103,
  "start": 245.16,
  "end": 248.18,
  "text": "For most people, bad feelings fade faster than good ones."
 },
 {
  "i": 104,
  "start": 248.58,
  "end": 249.5,
  "text": "Yours don't."
 },
 {
  "i": 105,
  "start": 249.76,
  "end": 251.54,
  "text": "Your first heartbreak, still sharp."
 },
 {
  "i": 106,
  "start": 251.9,
  "end": 254.96,
  "text": "Your fifth grade stage fright, you're sweating right now."
 },
 {
  "i": 107,
  "start": 255.32,
  "end": 257.54,
  "text": "Your most embarrassing moment, still hot."
 },
 {
  "i": 108,
  "start": 257.54,
  "end": 260.62,
  "text": "The worst day of your life, still full size."
 },
 {
  "i": 109,
  "start": 260.96,
  "end": 264.96,
  "text": "With sound, with smell, every replay feels brand new."
 },
 {
  "i": 110,
  "start": 265.48,
  "end": 265.58,
  "text": "Dr."
 },
 {
  "i": 111,
  "start": 265.8,
  "end": 266.74,
  "text": "Lee frowns."
 },
 {
  "i": 112,
  "start": 266.92,
  "end": 268.12,
  "text": "Memory isn't a recording."
 },
 {
  "i": 113,
  "start": 268.46,
  "end": 270.94,
  "text": "Each time you recall it, your brain rebuilds it."
 },
 {
  "i": 114,
  "start": 271.24,
  "end": 274.14,
  "text": "Yours rebuilds it perfectly and perfectly hurts."
 },
 {
  "i": 115,
  "start": 274.7,
  "end": 277.42,
  "text": "One night, you relive a bad day for six hours."
 },
 {
  "i": 116,
  "start": 277.82,
  "end": 278.92,
  "text": "Your pillow is soaked."
 },
 {
  "i": 117,
  "start": 279.38,
  "end": 280.64,
  "text": "Why can't you just let it go?"
 },
 {
  "i": 118,
  "start": 281.02,
  "end": 283.02,
  "text": "Because letting go needs forgetting."
 },
 {
  "i": 119,
  "start": 283.64,
  "end": 284.48,
  "text": "Then there's Leo."
 },
 {
  "i": 120,
  "start": 284.88,
  "end": 286.04,
  "text": "He taught you to ride a bike."
 },
 {
  "i": 121,
  "start": 286.04,
  "end": 287.72,
  "text": "He taught you the secret knock."
 },
 {
  "i": 122,
  "start": 288.14,
  "end": 289.6,
  "text": "Two quick taps on the kitchen table."
 },
 {
  "i": 123,
  "start": 289.9,
  "end": 290.6,
  "text": "One slow."
 },
 {
  "i": 124,
  "start": 291.0,
  "end": 292.84,
  "text": "He made it up for the nights you couldn't sleep."
 },
 {
  "i": 125,
  "start": 293.18,
  "end": 294.7,
  "text": "Two taps meant, I'm here."
 },
 {
  "i": 126,
  "start": 294.94,
  "end": 296.68,
  "text": "The slow one meant, it's okay."
 },
 {
  "i": 127,
  "start": 297.14,
  "end": 299.02,
  "text": "On Sundays, he burns the pancakes."
 },
 {
  "i": 128,
  "start": 299.48,
  "end": 300.86,
  "text": "You remember every one."
 },
 {
  "i": 129,
  "start": 301.34,
  "end": 303.3,
  "text": "412 burnt pancakes."
 },
 {
  "i": 130,
  "start": 303.72,
  "end": 304.82,
  "text": "You'd eat them all again."
 },
 {
  "i": 131,
  "start": 305.32,
  "end": 306.96,
  "text": "Lately, Leo forgets things."
 },
 {
  "i": 132,
  "start": 307.28,
  "end": 310.4,
  "text": "His glasses, your birthday, sometimes your name."
 },
 {
  "i": 133,
  "start": 310.84,
  "end": 313.54,
  "text": "So you tell his stories back to him, word for word."
 },
 {
  "i": 134,
  "start": 313.82,
  "end": 314.68,
  "text": "Did I tell you this one?"
 },
 {
  "i": 135,
  "start": 314.68,
  "end": 316.16,
  "text": "Four times, grandpa."
 },
 {
  "i": 136,
  "start": 316.38,
  "end": 317.36,
  "text": "The third was funnier."
 },
 {
  "i": 137,
  "start": 317.78,
  "end": 318.08,
  "text": "He laughs."
 },
 {
  "i": 138,
  "start": 318.66,
  "end": 319.56,
  "text": "Then his eyes drift."
 },
 {
  "i": 139,
  "start": 319.94,
  "end": 322.24,
  "text": "And he says the one sentence he never loses."
 },
 {
  "i": 140,
  "start": 323.02,
  "end": 324.04,
  "text": "Nothing fades for you, Max."
 },
 {
  "i": 141,
  "start": 324.52,
  "end": 325.5,
  "text": "So make it worth keeping."
 },
 {
  "i": 142,
  "start": 325.96,
  "end": 326.34,
  "text": "You nod."
 },
 {
  "i": 143,
  "start": 326.74,
  "end": 327.72,
  "text": "Of course you keep it."
 },
 {
  "i": 144,
  "start": 327.92,
  "end": 328.78,
  "text": "He pats the table."
 },
 {
  "i": 145,
  "start": 329.2,
  "end": 329.94,
  "text": "Two quick taps."
 },
 {
  "i": 146,
  "start": 330.38,
  "end": 331.0,
  "text": "One slow."
 },
 {
  "i": 147,
  "start": 331.5,
  "end": 332.6,
  "text": "You answer with the same."
 },
 {
  "i": 148,
  "start": 333.08,
  "end": 335.72,
  "text": "It's the only conversation that never needs words."
 },
 {
  "i": 149,
  "start": 336.54,
  "end": 338.62,
  "text": "Friday morning, a sticky note on the fridge."
 },
 {
  "i": 150,
  "start": 339.28,
  "end": 340.4,
  "text": "Leo's shaky handwriting."
 },
 {
  "i": 151,
  "start": 341.22,
  "end": 341.34,
  "text": "Bank."
 },
 {
  "i": 152,
  "start": 342.06,
  "end": 342.1,
  "text": "Noon."
 },
 {
  "i": 153,
  "start": 342.74,
  "end": 343.18,
  "text": "Safe account."
 },
 {
  "i": 154,
  "start": 343.68,
  "end": 344.14,
  "text": "You stare."
 },
 {
  "i": 155,
  "start": 344.66,
  "end": 345.38,
  "text": "Safe account?"
 },
 {
  "i": 156,
  "start": 345.9,
  "end": 346.78,
  "text": "Where have you heard that?"
 },
 {
  "i": 157,
  "start": 347.3,
  "end": 347.84,
  "text": "You call Leo."
 },
 {
  "i": 158,
  "start": 348.38,
  "end": 348.84,
  "text": "No answer."
 },
 {
  "i": 159,
  "start": 349.4,
  "end": 349.78,
  "text": "You run."
 },
 {
  "i": 160,
  "start": 350.38,
  "end": 353.12,
  "text": "At noon, you find him at the bank counter, pen in hand."
 },
 {
  "i": 161,
  "start": 353.58,
  "end": 356.08,
  "text": "A smiling man in a gray suit stands beside him."
 },
 {
  "i": 162,
  "start": 356.76,
  "end": 356.76,
  "text": "Mr."
 },
 {
  "i": 163,
  "start": 357.06,
  "end": 357.12,
  "text": "Black."
 },
 {
  "i": 164,
  "start": 357.6,
  "end": 358.64,
  "text": "His phone is on speaker."
 },
 {
  "i": 165,
  "start": 359.28,
  "end": 360.96,
  "text": "Sir, your savings are in danger."
 },
 {
  "i": 166,
  "start": 361.32,
  "end": 362.54,
  "text": "Move them to a safe account."
 },
 {
  "i": 167,
  "start": 362.86,
  "end": 363.12,
  "text": "Now!"
 },
 {
  "i": 168,
  "start": 363.64,
  "end": 364.52,
  "text": "Your stomach drops."
 },
 {
  "i": 169,
  "start": 365.12,
  "end": 366.06,
  "text": "You know that voice."
 },
 {
  "i": 170,
  "start": 366.68,
  "end": 368.38,
  "text": "Three weeks ago, it called the house."
 },
 {
  "i": 171,
  "start": 368.88,
  "end": 369.66,
  "text": "The water company."
 },
 {
  "i": 172,
  "start": 370.16,
  "end": 372.16,
  "text": "11 days ago, Leo's insurance."
 },
 {
  "i": 173,
  "start": 372.88,
  "end": 375.06,
  "text": "Today, the bank's security department."
 },
 {
  "i": 174,
  "start": 375.68,
  "end": 378.42,
  "text": "Same voice, same cough, same words."
 },
 {
  "i": 175,
  "start": 379.0,
  "end": 379.98,
  "text": "Sir, this is urgent!"
 },
 {
  "i": 176,
  "start": 380.5,
  "end": 381.3,
  "text": "You grab your phone."
 },
 {
  "i": 177,
  "start": 381.7,
  "end": 383.38,
  "text": "You never recorded a single call."
 },
 {
  "i": 178,
  "start": 383.86,
  "end": 384.46,
  "text": "Why would you?"
 },
 {
  "i": 179,
  "start": 384.88,
  "end": 385.78,
  "text": "You never forget."
 },
 {
  "i": 180,
  "start": 386.36,
  "end": 388.66,
  "text": "Above the counter, a clock reads 1201."
 },
 {
  "i": 181,
  "start": 389.28,
  "end": 391.16,
  "text": "Leo's pen is one hand from the line."
 },
 {
  "i": 182,
  "start": 391.54,
  "end": 393.14,
  "text": "A signature takes two seconds."
 },
 {
  "i": 183,
  "start": 393.54,
  "end": 394.68,
  "text": "You're 20 meters away."
 },
 {
  "i": 184,
  "start": 395.04,
  "end": 397.1,
  "text": "A fast run is five meters per second."
 },
 {
  "i": 185,
  "start": 397.56,
  "end": 398.08,
  "text": "Four seconds."
 },
 {
  "i": 186,
  "start": 398.6,
  "end": 399.06,
  "text": "Too slow."
 },
 {
  "i": 187,
  "start": 399.46,
  "end": 400.02,
  "text": "So you shout."
 },
 {
  "i": 188,
  "start": 400.46,
  "end": 401.08,
  "text": "It's a scam!"
 },
 {
  "i": 189,
  "start": 401.52,
  "end": 401.82,
  "text": "Mr."
 },
 {
  "i": 190,
  "start": 402.16,
  "end": 402.6,
  "text": "Black smiles."
 },
 {
  "i": 191,
  "start": 403.3,
  "end": 404.94,
  "text": "Kid, I saw you on TV."
 },
 {
  "i": 192,
  "start": 405.62,
  "end": 407.32,
  "text": "Nobody can see inside your head."
 },
 {
  "i": 193,
  "start": 407.72,
  "end": 408.9,
  "text": "The teller frowns."
 },
 {
  "i": 194,
  "start": 409.08,
  "end": 412.24,
  "text": "Sir, I can't stop a customer because of what a boy remembers."
 },
 {
  "i": 195,
  "start": 412.84,
  "end": 413.7,
  "text": "Your head floods."
 },
 {
  "i": 196,
  "start": 414.24,
  "end": 414.88,
  "text": "Three calls."
 },
 {
  "i": 197,
  "start": 415.3,
  "end": 416.0,
  "text": "Every word."
 },
 {
  "i": 198,
  "start": 416.52,
  "end": 417.36,
  "text": "Loud as a siren."
 },
 {
  "i": 199,
  "start": 417.74,
  "end": 419.24,
  "text": "And nobody else can hear it."
 },
 {
  "i": 200,
  "start": 419.62,
  "end": 419.82,
  "text": "Mr."
 },
 {
  "i": 201,
  "start": 420.12,
  "end": 420.82,
  "text": "Black leans close."
 },
 {
  "i": 202,
  "start": 421.38,
  "end": 423.7,
  "text": "Stay quiet and I'll pay you 10 ,000."
 },
 {
  "i": 203,
  "start": 424.02,
  "end": 424.98,
  "text": "A memory like yours?"
 },
 {
  "i": 204,
  "start": 425.44,
  "end": 426.28,
  "text": "We'd make a fortune."
 },
 {
  "i": 205,
  "start": 426.76,
  "end": 428.5,
  "text": "The money or your grandfather."
 },
 {
  "i": 206,
  "start": 429.18,
  "end": 429.84,
  "text": "Leo looks up."
 },
 {
  "i": 207,
  "start": 429.84,
  "end": 431.76,
  "text": "Who, who are you?"
 },
 {
  "i": 208,
  "start": 432.24,
  "end": 433.36,
  "text": "The pen touches the paper."
 },
 {
  "i": 209,
  "start": 433.76,
  "end": 435.02,
  "text": "You have one thing left."
 },
 {
  "i": 210,
  "start": 435.5,
  "end": 436.8,
  "text": "Two quick taps on the counter."
 },
 {
  "i": 211,
  "start": 437.28,
  "end": 437.94,
  "text": "One slow."
 },
 {
  "i": 212,
  "start": 438.6,
  "end": 439.52,
  "text": "Leo's hand freezes."
 },
 {
  "i": 213,
  "start": 440.44,
  "end": 440.54,
  "text": "Max?"
 },
 {
  "i": 214,
  "start": 441.12,
  "end": 442.38,
  "text": "Nothing fades, grandpa."
 },
 {
  "i": 215,
  "start": 442.76,
  "end": 443.94,
  "text": "So make it worth keeping."
 },
 {
  "i": 216,
  "start": 444.42,
  "end": 445.14,
  "text": "His eyes clear."
 },
 {
  "i": 217,
  "start": 445.62,
  "end": 446.46,
  "text": "Just for a moment."
 },
 {
  "i": 218,
  "start": 446.82,
  "end": 447.78,
  "text": "He puts the pen down."
 },
 {
  "i": 219,
  "start": 448.2,
  "end": 449.4,
  "text": "I don't know this man."
 },
 {
  "i": 220,
  "start": 449.78,
  "end": 450.88,
  "text": "The teller steps back."
 },
 {
  "i": 221,
  "start": 451.46,
  "end": 454.98,
  "text": "Sir, real banks never ask you to move money to a safe account."
 },
 {
  "i": 222,
  "start": 455.74,
  "end": 456.56,
  "text": "Security walks Mr."
 },
 {
  "i": 223,
  "start": 456.8,
  "end": 457.1,
  "text": "Black out."
 },
 {
  "i": 224,
  "start": 457.1,
  "end": 459.76,
  "text": "Behind you, the whole line starts clapping."
 },
 {
  "i": 225,
  "start": 460.34,
  "end": 462.64,
  "text": "Later, you sit with Leo and write it all down."
 },
 {
  "i": 226,
  "start": 463.08,
  "end": 466.02,
  "text": "Three calls, 11 pages, every word."
 },
 {
  "i": 227,
  "start": 466.48,
  "end": 469.1,
  "text": "Your memory can't be shared, but paper can."
 },
 {
  "i": 228,
  "start": 469.52,
  "end": 470.64,
  "text": "The police read it twice."
 },
 {
  "i": 229,
  "start": 471.18,
  "end": 473.56,
  "text": "This is as good as a recording, an officer says."
 },
 {
  "i": 230,
  "start": 474.0,
  "end": 475.4,
  "text": "You could ruin Black alone."
 },
 {
  "i": 231,
  "start": 475.86,
  "end": 478.04,
  "text": "Every secret he ever whispered near you."
 },
 {
  "i": 232,
  "start": 478.3,
  "end": 479.96,
  "text": "But then you'd be just like him."
 },
 {
  "i": 233,
  "start": 480.4,
  "end": 481.52,
  "text": "Leo hugs you in the car."
 },
 {
  "i": 234,
  "start": 481.96,
  "end": 483.92,
  "text": "By dinner, he's forgotten the whole day."
 },
 {
  "i": 235,
  "start": 484.36,
  "end": 485.12,
  "text": "You haven't."
 },
 {
  "i": 236,
  "start": 485.12,
  "end": 486.96,
  "text": "And for once, you're glad."
 },
 {
  "i": 237,
  "start": 487.44,
  "end": 488.6,
  "text": "Someone has to keep it."
 },
 {
  "i": 238,
  "start": 488.98,
  "end": 491.04,
  "text": "That night, your worst day comes back."
 },
 {
  "i": 239,
  "start": 491.42,
  "end": 492.1,
  "text": "You don't stay."
 },
 {
  "i": 240,
  "start": 492.5,
  "end": 493.98,
  "text": "You press play on another one."
 },
 {
  "i": 241,
  "start": 494.34,
  "end": 496.12,
  "text": "Two quick taps, one slow."
 },
 {
  "i": 242,
  "start": 496.54,
  "end": 498.72,
  "text": "And for the first time, it doesn't hurt."
 },
 {
  "i": 243,
  "start": 499.1,
  "end": 499.84,
  "text": "Nothing fades."
 },
 {
  "i": 244,
  "start": 500.34,
  "end": 501.5,
  "text": "So make it worth keeping."
 },
 {
  "i": 245,
  "start": 502.02,
  "end": 503.26,
  "text": "Then your phone lights up."
 },
 {
  "i": 246,
  "start": 503.74,
  "end": 505.66,
  "text": "Unknown number, a woman's voice."
 },
 {
  "i": 247,
  "start": 506.22,
  "end": 506.68,
  "text": "Hello, Max."
 },
 {
  "i": 248,
  "start": 507.22,
  "end": 507.94,
  "text": "Do you remember me?"
 },
 {
  "i": 249,
  "start": 508.3,
  "end": 511.56,
  "text": "You search every voice, every face, nothing."
 },
 {
  "i": 250,
  "start": 512.04,
  "end": 513.92,
  "text": "You've never forgotten anything before."
 },
 {
  "i": 251,
  "start": 513.92,
  "end": 515.94,
  "text": "So why can't you remember her?"
 },
 {
  "i": 252,
  "start": 516.48,
  "end": 517.82,
  "text": "But how much of this is real?"
 },
 {
  "i": 253,
  "start": 518.62,
  "end": 519.94,
  "text": "Perfect memory doesn't exist."
 },
 {
  "i": 254,
  "start": 520.48,
  "end": 525.46,
  "text": "In 1956, psychologist George Miller showed we hold about seven items at once."
 },
 {
  "i": 255,
  "start": 525.8,
  "end": 526.66,
  "text": "That part is real."
 },
 {
  "i": 256,
  "start": 527.16,
  "end": 528.86,
  "text": "Even vivid memories can be wrong."
 },
 {
  "i": 257,
  "start": 529.38,
  "end": 530.84,
  "text": "Confidence isn't accuracy."
 },
 {
  "i": 258,
  "start": 531.38,
  "end": 536.76,
  "text": "A rare few people have highly superior autobiographical memory, first described in 2006."
 },
 {
  "i": 259,
  "start": 537.3,
  "end": 539.5,
  "text": "They recall ordinary days in detail."
 },
 {
  "i": 260,
  "start": 539.82,
  "end": 543.3,
  "text": "But a 2013 study found they still fall for false memories."
 },
 {
  "i": 261,
  "start": 543.3,
  "end": 545.44,
  "text": "Because memory isn't a recording."
 },
 {
  "i": 262,
  "start": 545.92,
  "end": 546.52,
  "text": "It's a rebuild."
 },
 {
  "i": 263,
  "start": 547.1,
  "end": 551.7,
  "text": "And in a famous 1942 story, Borges imagined a man who forgot nothing."
 },
 {
  "i": 264,
  "start": 552.16,
  "end": 552.86,
  "text": "He couldn't think."
 },
 {
  "i": 265,
  "start": 553.38,
  "end": 555.06,
  "text": "Thinking means ignoring details."
 },
 {
  "i": 266,
  "start": 555.6,
  "end": 559.26,
  "text": "So could a brain really remember everything and still think?"
 },
 {
  "i": 267,
  "start": 559.82,
  "end": 560.44,
  "text": "What do you think?"
 },
 {
  "i": 268,
  "start": 560.8,
  "end": 564.02,
  "text": "Tell us in the comments and tell us which superpower we should do next."
 },
 {
  "i": 269,
  "start": 564.38,
  "end": 566.24,
  "text": "Hit like and subscribe for part two."
 }
]