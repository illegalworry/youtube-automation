[
 {
  "i": 0,
  "start": 0.0,
  "end": 0.42,
  "text": "Breakfast."
 },
 {
  "i": 1,
  "start": 1.16,
  "end": 2.96,
  "text": "Your little sister points her spoon at you."
 },
 {
  "i": 2,
  "start": 3.48,
  "end": 5.1,
  "text": "Broccoli is a fruit, she says."
 },
 {
  "i": 3,
  "start": 5.68,
  "end": 7.0,
  "text": "She talks for 10 seconds."
 },
 {
  "i": 4,
  "start": 7.52,
  "end": 8.58,
  "text": "You answer in two."
 },
 {
  "i": 5,
  "start": 9.08,
  "end": 10.14,
  "text": "Broccoli is a flower."
 },
 {
  "i": 6,
  "start": 10.7,
  "end": 12.0,
  "text": "You're about to eat a flower."
 },
 {
  "i": 7,
  "start": 12.62,
  "end": 13.26,
  "text": "She stares."
 },
 {
  "i": 8,
  "start": 13.82,
  "end": 14.88,
  "text": "Then she eats it."
 },
 {
  "i": 9,
  "start": 15.48,
  "end": 17.8,
  "text": "At school, your teacher says your essay is late."
 },
 {
  "i": 10,
  "start": 18.24,
  "end": 19.02,
  "text": "You point at the clock."
 },
 {
  "i": 11,
  "start": 19.52,
  "end": 21.28,
  "text": "It was early, by four minutes."
 },
 {
  "i": 12,
  "start": 21.9,
  "end": 22.32,
  "text": "He checks."
 },
 {
  "i": 13,
  "start": 22.88,
  "end": 23.34,
  "text": "He sighs."
 },
 {
  "i": 14,
  "start": 24.04,
  "end": 24.48,
  "text": "Full marks."
 },
 {
  "i": 15,
  "start": 25.32,
  "end": 28.26,
  "text": "A man at the bus stop yells that buses never come on time."
 },
 {
  "i": 16,
  "start": 28.7,
  "end": 29.76,
  "text": "You show him the timetable."
 },
 {
  "i": 17,
  "start": 30.0,
  "end": 30.84,
  "text": "He reads it."
 },
 {
  "i": 18,
  "start": 31.22,
  "end": 33.26,
  "text": "He apologizes to the timetable."
 },
 {
  "i": 19,
  "start": 33.92,
  "end": 37.12,
  "text": "A lawyer in an expensive suit says you can't lock your bike here."
 },
 {
  "i": 20,
  "start": 37.52,
  "end": 38.0,
  "text": "You smile."
 },
 {
  "i": 21,
  "start": 38.52,
  "end": 40.56,
  "text": "You quote the sign, word for word."
 },
 {
  "i": 22,
  "start": 41.04,
  "end": 41.8,
  "text": "He moves his car."
 },
 {
  "i": 23,
  "start": 42.34,
  "end": 44.02,
  "text": "Three arguments, three wins."
 },
 {
  "i": 24,
  "start": 44.78,
  "end": 47.3,
  "text": "Before lunch, you didn't raise your voice once."
 },
 {
  "i": 25,
  "start": 47.72,
  "end": 51.52,
  "text": "You barely even thought, and your cat still won't get off your keyboard."
 },
 {
  "i": 26,
  "start": 52.28,
  "end": 55.1,
  "text": "Your name is Max, and your brain works differently."
 },
 {
  "i": 27,
  "start": 55.68,
  "end": 58.5,
  "text": "A normal person speaks about 150 words a minute."
 },
 {
  "i": 28,
  "start": 58.94,
  "end": 61.02,
  "text": "They hold about four ideas in mind at once."
 },
 {
  "i": 29,
  "start": 61.62,
  "end": 61.78,
  "text": "You?"
 },
 {
  "i": 30,
  "start": 62.2,
  "end": 63.06,
  "text": "You hold 40."
 },
 {
  "i": 31,
  "start": 63.48,
  "end": 67.2,
  "text": "And when someone stops talking, they answer in roughly two tenths of a second."
 },
 {
  "i": 32,
  "start": 67.64,
  "end": 68.22,
  "text": "That's a blink."
 },
 {
  "i": 33,
  "start": 68.88,
  "end": 69.06,
  "text": "You?"
 },
 {
  "i": 34,
  "start": 69.4,
  "end": 71.92,
  "text": "You hear half a sentence and see the weak spot."
 },
 {
  "i": 35,
  "start": 72.28,
  "end": 72.88,
  "text": "Every gap."
 },
 {
  "i": 36,
  "start": 73.18,
  "end": 73.82,
  "text": "Every trick."
 },
 {
  "i": 37,
  "start": 74.18,
  "end": 74.86,
  "text": "Every flaw."
 },
 {
  "i": 38,
  "start": 75.36,
  "end": 77.02,
  "text": "You know which word they'll use next."
 },
 {
  "i": 39,
  "start": 77.3,
  "end": 78.38,
  "text": "Which fact they'll dodge."
 },
 {
  "i": 40,
  "start": 78.9,
  "end": 81.18,
  "text": "It's like watching a chess game three moves early."
 },
 {
  "i": 41,
  "start": 81.62,
  "end": 83.34,
  "text": "Then the perfect words arrive."
 },
 {
  "i": 42,
  "start": 83.7,
  "end": 84.24,
  "text": "Instantly."
 },
 {
  "i": 43,
  "start": 84.58,
  "end": 85.78,
  "text": "Like they were waiting for you."
 },
 {
  "i": 44,
  "start": 85.78,
  "end": 87.44,
  "text": "Nobody gave you a manual."
 },
 {
  "i": 45,
  "start": 87.78,
  "end": 90.62,
  "text": "Just a normal Tuesday and a brain that woke up faster."
 },
 {
  "i": 46,
  "start": 91.2,
  "end": 91.98,
  "text": "But there's a rule."
 },
 {
  "i": 47,
  "start": 92.44,
  "end": 94.08,
  "text": "Your brain got faster at words."
 },
 {
  "i": 48,
  "start": 94.58,
  "end": 96.56,
  "text": "People did not get faster at changing."
 },
 {
  "i": 49,
  "start": 97.16,
  "end": 99.74,
  "text": "You can win the argument, but you can't win the person."
 },
 {
  "i": 50,
  "start": 100.2,
  "end": 101.04,
  "text": "They'll say you're right."
 },
 {
  "i": 51,
  "start": 101.34,
  "end": 103.22,
  "text": "Then they'll do exactly what they wanted."
 },
 {
  "i": 52,
  "start": 103.68,
  "end": 105.4,
  "text": "So what if you could win every argument?"
 },
 {
  "i": 53,
  "start": 106.0,
  "end": 106.82,
  "text": "It starts small."
 },
 {
  "i": 54,
  "start": 107.26,
  "end": 108.86,
  "text": "Your phone bill has a mystery fee."
 },
 {
  "i": 55,
  "start": 109.3,
  "end": 110.62,
  "text": "The agent says it's policy."
 },
 {
  "i": 56,
  "start": 111.2,
  "end": 113.16,
  "text": "You read her own policy back to her."
 },
 {
  "i": 57,
  "start": 113.16,
  "end": 113.98,
  "text": "Calmly."
 },
 {
  "i": 58,
  "start": 114.3,
  "end": 115.1,
  "text": "She goes quiet."
 },
 {
  "i": 59,
  "start": 115.6,
  "end": 116.52,
  "text": "The fee disappears."
 },
 {
  "i": 60,
  "start": 117.06,
  "end": 118.64,
  "text": "Plus $40 saved."
 },
 {
  "i": 61,
  "start": 119.1,
  "end": 119.6,
  "text": "Minus."
 },
 {
  "i": 62,
  "start": 119.98,
  "end": 121.6,
  "text": "She sounds tired when she says goodbye."
 },
 {
  "i": 63,
  "start": 122.42,
  "end": 122.82,
  "text": "Bedtime."
 },
 {
  "i": 64,
  "start": 123.32,
  "end": 125.5,
  "text": "Your little sister Mia says she's not tired."
 },
 {
  "i": 65,
  "start": 125.82,
  "end": 126.5,
  "text": "Not even a little."
 },
 {
  "i": 66,
  "start": 126.96,
  "end": 128.66,
  "text": "You list five reasons she is."
 },
 {
  "i": 67,
  "start": 129.14,
  "end": 131.04,
  "text": "She yawns halfway through her own answer."
 },
 {
  "i": 68,
  "start": 131.5,
  "end": 132.22,
  "text": "She goes to bed."
 },
 {
  "i": 69,
  "start": 132.7,
  "end": 133.32,
  "text": "No hug tonight."
 },
 {
  "i": 70,
  "start": 133.88,
  "end": 134.44,
  "text": "Minus."
 },
 {
  "i": 71,
  "start": 134.98,
  "end": 137.18,
  "text": "Your uncle swears he cooks better than your aunt."
 },
 {
  "i": 72,
  "start": 137.54,
  "end": 138.7,
  "text": "You settle it at the table."
 },
 {
  "i": 73,
  "start": 139.16,
  "end": 140.2,
  "text": "Nobody eats dessert."
 },
 {
  "i": 74,
  "start": 140.2,
  "end": 142.82,
  "text": "A classmate swears the earth is flat."
 },
 {
  "i": 75,
  "start": 143.1,
  "end": 143.92,
  "text": "Just to test you."
 },
 {
  "i": 76,
  "start": 144.32,
  "end": 146.2,
  "text": "You prove it's round in 60 seconds."
 },
 {
  "i": 77,
  "start": 146.48,
  "end": 147.74,
  "text": "With a lamp and a spoon."
 },
 {
  "i": 78,
  "start": 148.26,
  "end": 148.92,
  "text": "He says fine."
 },
 {
  "i": 79,
  "start": 149.38,
  "end": 150.88,
  "text": "He still squints at the horizon."
 },
 {
  "i": 80,
  "start": 151.5,
  "end": 153.1,
  "text": "Next week, Mia wants a puppy."
 },
 {
  "i": 81,
  "start": 153.6,
  "end": 154.56,
  "text": "Your parents say no."
 },
 {
  "i": 82,
  "start": 154.92,
  "end": 155.7,
  "text": "So you teach her."
 },
 {
  "i": 83,
  "start": 156.16,
  "end": 156.74,
  "text": "Five points."
 },
 {
  "i": 84,
  "start": 157.06,
  "end": 157.62,
  "text": "Short ones."
 },
 {
  "i": 85,
  "start": 158.04,
  "end": 158.56,
  "text": "Calm ones."
 },
 {
  "i": 86,
  "start": 159.0,
  "end": 159.7,
  "text": "Your mom listens."
 },
 {
  "i": 87,
  "start": 160.16,
  "end": 160.86,
  "text": "Your dad listens."
 },
 {
  "i": 88,
  "start": 161.26,
  "end": 162.32,
  "text": "They say maybe."
 },
 {
  "i": 89,
  "start": 162.96,
  "end": 163.64,
  "text": "Mia screams."
 },
 {
  "i": 90,
  "start": 164.22,
  "end": 165.84,
  "text": "In Mia language, that's a yes."
 },
 {
  "i": 91,
  "start": 166.38,
  "end": 167.42,
  "text": "Mia draws a horse."
 },
 {
  "i": 92,
  "start": 167.88,
  "end": 169.46,
  "text": "You spot the mistake instantly."
 },
 {
  "i": 93,
  "start": 169.46,
  "end": 170.7,
  "text": "Five legs."
 },
 {
  "i": 94,
  "start": 171.24,
  "end": 171.76,
  "text": "You tell her."
 },
 {
  "i": 95,
  "start": 171.98,
  "end": 172.42,
  "text": "Kindly."
 },
 {
  "i": 96,
  "start": 172.78,
  "end": 173.16,
  "text": "You're right."
 },
 {
  "i": 97,
  "start": 173.64,
  "end": 174.68,
  "text": "Mia's face crumbles."
 },
 {
  "i": 98,
  "start": 175.22,
  "end": 176.92,
  "text": "She never shows you a drawing again."
 },
 {
  "i": 99,
  "start": 177.38,
  "end": 177.78,
  "text": "Right."
 },
 {
  "i": 100,
  "start": 178.34,
  "end": 179.66,
  "text": "And somehow wrong."
 },
 {
  "i": 101,
  "start": 180.2,
  "end": 181.94,
  "text": "Your teacher signs you up for debate club."
 },
 {
  "i": 102,
  "start": 182.3,
  "end": 182.88,
  "text": "First round."
 },
 {
  "i": 103,
  "start": 183.2,
  "end": 183.72,
  "text": "Eight students."
 },
 {
  "i": 104,
  "start": 184.18,
  "end": 184.86,
  "text": "One after another."
 },
 {
  "i": 105,
  "start": 185.2,
  "end": 186.96,
  "text": "You beat the first in 40 seconds."
 },
 {
  "i": 106,
  "start": 187.28,
  "end": 188.38,
  "text": "The second in 30."
 },
 {
  "i": 107,
  "start": 188.7,
  "end": 190.22,
  "text": "The eighth just shakes your hand."
 },
 {
  "i": 108,
  "start": 190.54,
  "end": 191.64,
  "text": "The coach stares at you."
 },
 {
  "i": 109,
  "start": 192.04,
  "end": 192.6,
  "text": "How…"
 },
 {
  "i": 110,
  "start": 192.6,
  "end": 193.7,
  "text": "how did you do that?"
 },
 {
  "i": 111,
  "start": 194.1,
  "end": 194.56,
  "text": "You shrug."
 },
 {
  "i": 112,
  "start": 194.9,
  "end": 195.84,
  "text": "You really don't know."
 },
 {
  "i": 113,
  "start": 196.24,
  "end": 197.6,
  "text": "You apply for a summer job."
 },
 {
  "i": 114,
  "start": 197.94,
  "end": 199.12,
  "text": "12 minutes with the manager."
 },
 {
  "i": 115,
  "start": 199.12,
  "end": 201.02,
  "text": "He asks why he should hire you."
 },
 {
  "i": 116,
  "start": 201.28,
  "end": 201.78,
  "text": "You tell him."
 },
 {
  "i": 117,
  "start": 202.06,
  "end": 203.24,
  "text": "He asks when you can start."
 },
 {
  "i": 118,
  "start": 203.72,
  "end": 207.24,
  "text": "Today, he says, he's already sliding a uniform across the desk."
 },
 {
  "i": 119,
  "start": 207.68,
  "end": 208.9,
  "text": "Then you open the internet."
 },
 {
  "i": 120,
  "start": 209.4,
  "end": 210.1,
  "text": "Big mistake."
 },
 {
  "i": 121,
  "start": 210.52,
  "end": 211.38,
  "text": "A comment war."
 },
 {
  "i": 122,
  "start": 211.72,
  "end": 212.86,
  "text": "200 strangers."
 },
 {
  "i": 123,
  "start": 213.48,
  "end": 215.84,
  "text": "You answer every single one in one evening."
 },
 {
  "i": 124,
  "start": 216.18,
  "end": 217.6,
  "text": "Not one changes their mind."
 },
 {
  "i": 125,
  "start": 217.92,
  "end": 218.52,
  "text": "Of course not."
 },
 {
  "i": 126,
  "start": 218.84,
  "end": 219.58,
  "text": "They just…"
 },
 {
  "i": 127,
  "start": 219.58,
  "end": 220.22,
  "text": "stop replying."
 },
 {
  "i": 128,
  "start": 220.6,
  "end": 221.32,
  "text": "You still win."
 },
 {
  "i": 129,
  "start": 221.68,
  "end": 221.98,
  "text": "Technically."
 },
 {
  "i": 130,
  "start": 222.54,
  "end": 224.1,
  "text": "Your neighbor argues about the fence."
 },
 {
  "i": 131,
  "start": 224.46,
  "end": 226.0,
  "text": "You settle it in 90 seconds."
 },
 {
  "i": 132,
  "start": 226.4,
  "end": 227.56,
  "text": "He stops waving at you."
 },
 {
  "i": 133,
  "start": 227.56,
  "end": 228.34,
  "text": "Minus."
 },
 {
  "i": 134,
  "start": 228.78,
  "end": 231.4,
  "text": "The principal wants to close the library on Saturdays."
 },
 {
  "i": 135,
  "start": 231.66,
  "end": 232.86,
  "text": "You give her three reasons."
 },
 {
  "i": 136,
  "start": 233.26,
  "end": 233.92,
  "text": "She keeps it open."
 },
 {
  "i": 137,
  "start": 234.34,
  "end": 234.52,
  "text": "Plus."
 },
 {
  "i": 138,
  "start": 235.22,
  "end": 237.6,
  "text": "A boy in your class gets blamed for a missing laptop."
 },
 {
  "i": 139,
  "start": 237.96,
  "end": 239.04,
  "text": "His story has a hole."
 },
 {
  "i": 140,
  "start": 239.38,
  "end": 240.78,
  "text": "You find it in 10 seconds."
 },
 {
  "i": 141,
  "start": 241.18,
  "end": 242.7,
  "text": "The time on the camera doesn't match."
 },
 {
  "i": 142,
  "start": 243.06,
  "end": 243.52,
  "text": "He's cleared."
 },
 {
  "i": 143,
  "start": 243.92,
  "end": 245.34,
  "text": "His mom hugs you in the hallway."
 },
 {
  "i": 144,
  "start": 245.8,
  "end": 246.98,
  "text": "Best wins so far."
 },
 {
  "i": 145,
  "start": 247.42,
  "end": 249.98,
  "text": "On Saturday, a referee cancels Leo's goal."
 },
 {
  "i": 146,
  "start": 250.32,
  "end": 251.46,
  "text": "Leo is furious."
 },
 {
  "i": 147,
  "start": 251.98,
  "end": 252.62,
  "text": "You walk over."
 },
 {
  "i": 148,
  "start": 252.94,
  "end": 253.22,
  "text": "Calm."
 },
 {
  "i": 149,
  "start": 253.58,
  "end": 255.1,
  "text": "You explain the offside law."
 },
 {
  "i": 150,
  "start": 255.1,
  "end": 256.14,
  "text": "Law 11."
 },
 {
  "i": 151,
  "start": 256.6,
  "end": 258.04,
  "text": "The referee asks the linesman."
 },
 {
  "i": 152,
  "start": 258.38,
  "end": 258.72,
  "text": "Nods."
 },
 {
  "i": 153,
  "start": 259.1,
  "end": 259.72,
  "text": "Changes the call."
 },
 {
  "i": 154,
  "start": 260.14,
  "end": 261.36,
  "text": "Leo grabs your shoulders."
 },
 {
  "i": 155,
  "start": 261.8,
  "end": 262.06,
  "text": "Dude."
 },
 {
  "i": 156,
  "start": 262.4,
  "end": 264.88,
  "text": "That man has never changed a call in his life."
 },
 {
  "i": 157,
  "start": 265.44,
  "end": 267.2,
  "text": "Leo's dad works nights at a warehouse."
 },
 {
  "i": 158,
  "start": 267.72,
  "end": 269.8,
  "text": "His boss says the extra hours don't count."
 },
 {
  "i": 159,
  "start": 270.16,
  "end": 271.86,
  "text": "You sit at their kitchen table with a notebook."
 },
 {
  "i": 160,
  "start": 272.24,
  "end": 273.56,
  "text": "You add up every hour."
 },
 {
  "i": 161,
  "start": 273.98,
  "end": 274.68,
  "text": "Three pages."
 },
 {
  "i": 162,
  "start": 275.14,
  "end": 276.22,
  "text": "His dad reads it twice."
 },
 {
  "i": 163,
  "start": 276.7,
  "end": 278.48,
  "text": "Next month, his paycheck is bigger."
 },
 {
  "i": 164,
  "start": 278.84,
  "end": 280.02,
  "text": "He tries to pay you in cake."
 },
 {
  "i": 165,
  "start": 280.42,
  "end": 280.86,
  "text": "You accept."
 },
 {
  "i": 166,
  "start": 281.2,
  "end": 281.6,
  "text": "Obviously."
 },
 {
  "i": 167,
  "start": 282.13,
  "end": 287.0,
  "text": "A real lawyer, 40 years in court, volunteers to face you in a school mock trial."
 },
 {
  "i": 168,
  "start": 287.36,
  "end": 287.96,
  "text": "12 minutes."
 },
 {
  "i": 169,
  "start": 288.4,
  "end": 290.28,
  "text": "Halfway through, she closes her folder."
 },
 {
  "i": 170,
  "start": 290.62,
  "end": 292.36,
  "text": "Nobody has ever done that to her."
 },
 {
  "i": 171,
  "start": 292.66,
  "end": 294.04,
  "text": "She asks to shake your hand."
 },
 {
  "i": 172,
  "start": 294.46,
  "end": 295.86,
  "text": "Your landlord raises the rent."
 },
 {
  "i": 173,
  "start": 296.2,
  "end": 297.6,
  "text": "Your mom stares at the letter."
 },
 {
  "i": 174,
  "start": 297.96,
  "end": 299.18,
  "text": "You read the contract once."
 },
 {
  "i": 175,
  "start": 299.54,
  "end": 300.3,
  "text": "You find the clause."
 },
 {
  "i": 176,
  "start": 300.72,
  "end": 301.28,
  "text": "You call him."
 },
 {
  "i": 177,
  "start": 301.58,
  "end": 302.06,
  "text": "Four minutes."
 },
 {
  "i": 178,
  "start": 302.48,
  "end": 303.44,
  "text": "He cancels the raise."
 },
 {
  "i": 179,
  "start": 303.86,
  "end": 304.62,
  "text": "Your mom cries."
 },
 {
  "i": 180,
  "start": 305.12,
  "end": 305.58,
  "text": "Good tears."
 },
 {
  "i": 181,
  "start": 306.02,
  "end": 308.28,
  "text": "She hugs you so tight your ribs creak."
 },
 {
  "i": 182,
  "start": 308.4,
  "end": 310.34,
  "text": "And you think, this is why you have it."
 },
 {
  "i": 183,
  "start": 310.34,
  "end": 313.2,
  "text": "Then a famous host invites you on live TV."
 },
 {
  "i": 184,
  "start": 313.64,
  "end": 315.04,
  "text": "Two million people watch."
 },
 {
  "i": 185,
  "start": 315.46,
  "end": 316.44,
  "text": "He tries to corner you."
 },
 {
  "i": 186,
  "start": 316.72,
  "end": 318.4,
  "text": "Three questions in, he's nodding."
 },
 {
  "i": 187,
  "start": 318.74,
  "end": 320.46,
  "text": "Five questions in, he's agreeing."
 },
 {
  "i": 188,
  "start": 321.06,
  "end": 321.52,
  "text": "With you."
 },
 {
  "i": 189,
  "start": 322.06,
  "end": 323.62,
  "text": "Your phone won't stop buzzing."
 },
 {
  "i": 190,
  "start": 324.1,
  "end": 325.22,
  "text": "Even you have limits."
 },
 {
  "i": 191,
  "start": 325.82,
  "end": 327.58,
  "text": "Your coin gets stuck in a vending machine."
 },
 {
  "i": 192,
  "start": 328.14,
  "end": 329.66,
  "text": "You give it your best argument."
 },
 {
  "i": 193,
  "start": 330.16,
  "end": 330.64,
  "text": "Out loud."
 },
 {
  "i": 194,
  "start": 331.06,
  "end": 332.0,
  "text": "For two minutes."
 },
 {
  "i": 195,
  "start": 332.52,
  "end": 334.0,
  "text": "The machine does not care."
 },
 {
  "i": 196,
  "start": 334.5,
  "end": 334.82,
  "text": "The catch?"
 },
 {
  "i": 197,
  "start": 335.36,
  "end": 336.6,
  "text": "You win every time."
 },
 {
  "i": 198,
  "start": 336.9,
  "end": 339.88,
  "text": "And every time, the other person leaves a little smaller."
 },
 {
  "i": 199,
  "start": 340.32,
  "end": 343.12,
  "text": "But where it gets really crazy is the city council."
 },
 {
  "i": 200,
  "start": 343.66,
  "end": 345.3,
  "text": "Your street has no crosswalk."
 },
 {
  "i": 201,
  "start": 345.72,
  "end": 346.52,
  "text": "Kids cross anyway."
 },
 {
  "i": 202,
  "start": 347.08,
  "end": 348.42,
  "text": "You speak for three minutes."
 },
 {
  "i": 203,
  "start": 348.92,
  "end": 350.88,
  "text": "When you finish, the room is silent."
 },
 {
  "i": 204,
  "start": 351.36,
  "end": 352.2,
  "text": "Then they vote."
 },
 {
  "i": 205,
  "start": 352.68,
  "end": 353.6,
  "text": "11 to 0."
 },
 {
  "i": 206,
  "start": 354.12,
  "end": 355.86,
  "text": "By spring, there's paint on the road."
 },
 {
  "i": 207,
  "start": 356.32,
  "end": 356.86,
  "text": "Bright yellow."
 },
 {
  "i": 208,
  "start": 357.32,
  "end": 359.66,
  "text": "A little girl crosses it on her first day of school."
 },
 {
  "i": 209,
  "start": 359.98,
  "end": 362.2,
  "text": "And you think, maybe this is what it's for."
 },
 {
  "i": 210,
  "start": 362.68,
  "end": 364.2,
  "text": "Now the part nobody mentions."
 },
 {
  "i": 211,
  "start": 364.78,
  "end": 366.32,
  "text": "Winning feels amazing."
 },
 {
  "i": 212,
  "start": 366.32,
  "end": 370.14,
  "text": "At first, dopamine cells fire hardest for surprises."
 },
 {
  "i": 213,
  "start": 370.56,
  "end": 371.6,
  "text": "For better than expected."
 },
 {
  "i": 214,
  "start": 372.08,
  "end": 373.5,
  "text": "But you always expect to win."
 },
 {
  "i": 215,
  "start": 373.88,
  "end": 374.78,
  "text": "And you always do."
 },
 {
  "i": 216,
  "start": 375.22,
  "end": 376.66,
  "text": "So nothing fires."
 },
 {
  "i": 217,
  "start": 377.28,
  "end": 377.76,
  "text": "No spark."
 },
 {
  "i": 218,
  "start": 378.32,
  "end": 379.38,
  "text": "Just a quiet click."
 },
 {
  "i": 219,
  "start": 379.84,
  "end": 380.76,
  "text": "Like closing a drawer."
 },
 {
  "i": 220,
  "start": 381.3,
  "end": 383.06,
  "text": "A win used to feel like a trophy."
 },
 {
  "i": 221,
  "start": 383.54,
  "end": 385.06,
  "text": "Now it feels like a receipt."
 },
 {
  "i": 222,
  "start": 385.5,
  "end": 387.2,
  "text": "And your brain is paying for it."
 },
 {
  "i": 223,
  "start": 387.5,
  "end": 389.3,
  "text": "It's about 2 % of your body weight."
 },
 {
  "i": 224,
  "start": 389.5,
  "end": 391.68,
  "text": "But it burns about 20 % of your energy."
 },
 {
  "i": 225,
  "start": 392.18,
  "end": 393.12,
  "text": "Yours burns more."
 },
 {
  "i": 226,
  "start": 393.12,
  "end": 394.74,
  "text": "You're starving by 10."
 },
 {
  "i": 227,
  "start": 395.3,
  "end": 396.2,
  "text": "Headaches by noon."
 },
 {
  "i": 228,
  "start": 396.7,
  "end": 397.98,
  "text": "At night, it gets worse."
 },
 {
  "i": 229,
  "start": 398.54,
  "end": 399.26,
  "text": "You lie awake."
 },
 {
  "i": 230,
  "start": 399.74,
  "end": 402.12,
  "text": "Your brain replays arguments from hours ago."
 },
 {
  "i": 231,
  "start": 402.54,
  "end": 404.1,
  "text": "It finds a better answer to each."
 },
 {
  "i": 232,
  "start": 404.64,
  "end": 407.56,
  "text": "At 2am, you're still winning fights that ended at lunch."
 },
 {
  "i": 233,
  "start": 408.08,
  "end": 409.94,
  "text": "You start spotting flaws in everything."
 },
 {
  "i": 234,
  "start": 410.52,
  "end": 411.0,
  "text": "A song."
 },
 {
  "i": 235,
  "start": 411.36,
  "end": 411.8,
  "text": "A joke."
 },
 {
  "i": 236,
  "start": 412.18,
  "end": 413.6,
  "text": "Your friend's story about his weekend."
 },
 {
  "i": 237,
  "start": 414.06,
  "end": 414.7,
  "text": "You say so."
 },
 {
  "i": 238,
  "start": 415.08,
  "end": 415.48,
  "text": "Out loud."
 },
 {
  "i": 239,
  "start": 415.96,
  "end": 416.26,
  "text": "Once."
 },
 {
  "i": 240,
  "start": 416.82,
  "end": 418.32,
  "text": "He never finishes the story."
 },
 {
  "i": 241,
  "start": 418.76,
  "end": 419.02,
  "text": "Dr."
 },
 {
  "i": 242,
  "start": 419.2,
  "end": 420.08,
  "text": "Lee checks your scans."
 },
 {
  "i": 243,
  "start": 420.6,
  "end": 421.68,
  "text": "Your brain is fine, Max."
 },
 {
  "i": 244,
  "start": 421.68,
  "end": 423.06,
  "text": "It's just running hot."
 },
 {
  "i": 245,
  "start": 423.48,
  "end": 423.7,
  "text": "Eat."
 },
 {
  "i": 246,
  "start": 424.18,
  "end": 424.44,
  "text": "Sleep."
 },
 {
  "i": 247,
  "start": 425.04,
  "end": 425.54,
  "text": "She pauses."
 },
 {
  "i": 248,
  "start": 426.0,
  "end": 427.6,
  "text": "And try losing sometimes."
 },
 {
  "i": 249,
  "start": 428.4,
  "end": 428.7,
  "text": "Losing?"
 },
 {
  "i": 250,
  "start": 429.14,
  "end": 429.46,
  "text": "Why?"
 },
 {
  "i": 251,
  "start": 429.98,
  "end": 432.92,
  "text": "Because a mind that never loses forgets how to listen."
 },
 {
  "i": 252,
  "start": 433.42,
  "end": 436.1,
  "text": "Then at dinner, your dad says the garage needs cleaning."
 },
 {
  "i": 253,
  "start": 436.56,
  "end": 438.36,
  "text": "You list six reasons it can wait."
 },
 {
  "i": 254,
  "start": 438.76,
  "end": 439.54,
  "text": "He opens his mouth."
 },
 {
  "i": 255,
  "start": 440.02,
  "end": 440.6,
  "text": "Closes it."
 },
 {
  "i": 256,
  "start": 441.02,
  "end": 441.52,
  "text": "Fine, Max."
 },
 {
  "i": 257,
  "start": 441.94,
  "end": 442.2,
  "text": "Fine."
 },
 {
  "i": 258,
  "start": 442.72,
  "end": 443.56,
  "text": "Not you're right."
 },
 {
  "i": 259,
  "start": 443.9,
  "end": 444.86,
  "text": "Just fine."
 },
 {
  "i": 260,
  "start": 445.4,
  "end": 447.0,
  "text": "Mia stops showing you her drawings."
 },
 {
  "i": 261,
  "start": 447.36,
  "end": 449.0,
  "text": "She says you only look for mistakes."
 },
 {
  "i": 262,
  "start": 449.0,
  "end": 451.64,
  "text": "At school, you stop raising your hand."
 },
 {
  "i": 263,
  "start": 452.0,
  "end": 453.72,
  "text": "Everyone already knows how it ends."
 },
 {
  "i": 264,
  "start": 454.24,
  "end": 456.88,
  "text": "A teacher calls you the last word in every room."
 },
 {
  "i": 265,
  "start": 457.26,
  "end": 458.54,
  "text": "It doesn't sound like a compliment."
 },
 {
  "i": 266,
  "start": 459.12,
  "end": 460.6,
  "text": "Nobody argues with you anymore."
 },
 {
  "i": 267,
  "start": 461.08,
  "end": 462.8,
  "text": "Your friends go quiet when you walk in."
 },
 {
  "i": 268,
  "start": 463.24,
  "end": 464.92,
  "text": "Your mom stops asking what you think."
 },
 {
  "i": 269,
  "start": 465.4,
  "end": 465.98,
  "text": "Why would she?"
 },
 {
  "i": 270,
  "start": 466.34,
  "end": 467.16,
  "text": "You already won."
 },
 {
  "i": 271,
  "start": 467.6,
  "end": 468.74,
  "text": "And something is coming."
 },
 {
  "i": 272,
  "start": 469.2,
  "end": 469.98,
  "text": "You can feel it."
 },
 {
  "i": 273,
  "start": 470.3,
  "end": 472.58,
  "text": "There's one person you never argue against."
 },
 {
  "i": 274,
  "start": 473.02,
  "end": 473.3,
  "text": "Leo."
 },
 {
  "i": 275,
  "start": 473.82,
  "end": 475.46,
  "text": "Your best friend since you were six."
 },
 {
  "i": 276,
  "start": 475.46,
  "end": 477.22,
  "text": "Left foot like a cannon."
 },
 {
  "i": 277,
  "start": 477.64,
  "end": 480.42,
  "text": "His dad works night shifts so Leo can have real boots."
 },
 {
  "i": 278,
  "start": 480.86,
  "end": 482.62,
  "text": "His dream fits in one sentence."
 },
 {
  "i": 279,
  "start": 483.12,
  "end": 484.42,
  "text": "Play for a real club."
 },
 {
  "i": 280,
  "start": 484.92,
  "end": 487.72,
  "text": "And between you two, every fight ends the same way."
 },
 {
  "i": 281,
  "start": 488.14,
  "end": 489.76,
  "text": "The loser says, you win."
 },
 {
  "i": 282,
  "start": 490.18,
  "end": 490.82,
  "text": "I hate it."
 },
 {
  "i": 283,
  "start": 491.24,
  "end": 492.54,
  "text": "The winner buys the churros."
 },
 {
  "i": 284,
  "start": 493.14,
  "end": 496.5,
  "text": "Since you were eight, you've never used your power on Leo."
 },
 {
  "i": 285,
  "start": 496.86,
  "end": 497.56,
  "text": "Not once."
 },
 {
  "i": 286,
  "start": 497.96,
  "end": 500.18,
  "text": "Because with Leo, you lose half the time."
 },
 {
  "i": 287,
  "start": 500.54,
  "end": 502.26,
  "text": "And somehow, you love it."
 },
 {
  "i": 288,
  "start": 502.66,
  "end": 504.86,
  "text": "He's the only person who tells you you're wrong."
 },
 {
  "i": 289,
  "start": 504.86,
  "end": 506.18,
  "text": "Then buys you food."
 },
 {
  "i": 290,
  "start": 506.72,
  "end": 509.12,
  "text": "His dad comes to every match in work boots."
 },
 {
  "i": 291,
  "start": 509.3,
  "end": 510.46,
  "text": "Straight off a night shift."
 },
 {
  "i": 292,
  "start": 510.92,
  "end": 512.88,
  "text": "He falls asleep on the bench by half time."
 },
 {
  "i": 293,
  "start": 513.36,
  "end": 514.58,
  "text": "Leo pretends not to notice."
 },
 {
  "i": 294,
  "start": 515.16,
  "end": 516.1,
  "text": "He always looks."
 },
 {
  "i": 295,
  "start": 516.78,
  "end": 519.12,
  "text": "On your 10th birthday, Leo gave you a drawing."
 },
 {
  "i": 296,
  "start": 519.6,
  "end": 520.4,
  "text": "Two stick figures."
 },
 {
  "i": 297,
  "start": 520.86,
  "end": 521.7,
  "text": "One holds a trophy."
 },
 {
  "i": 298,
  "start": 522.12,
  "end": 523.12,
  "text": "One eats churros."
 },
 {
  "i": 299,
  "start": 523.58,
  "end": 524.58,
  "text": "It's still on your wall."
 },
 {
  "i": 300,
  "start": 525.1,
  "end": 527.02,
  "text": "Last spring, Leo missed a penalty."
 },
 {
  "i": 301,
  "start": 527.48,
  "end": 528.5,
  "text": "In front of everyone."
 },
 {
  "i": 302,
  "start": 529.18,
  "end": 531.06,
  "text": "Afterward, he sat alone on the grass."
 },
 {
  "i": 303,
  "start": 531.62,
  "end": 532.74,
  "text": "You sat down next to him."
 },
 {
  "i": 304,
  "start": 532.74,
  "end": 534.76,
  "text": "You didn't say one clever thing."
 },
 {
  "i": 305,
  "start": 535.16,
  "end": 535.88,
  "text": "You just stayed."
 },
 {
  "i": 306,
  "start": 536.42,
  "end": 536.82,
  "text": "An hour."
 },
 {
  "i": 307,
  "start": 537.3,
  "end": 537.66,
  "text": "Quiet."
 },
 {
  "i": 308,
  "start": 538.28,
  "end": 539.3,
  "text": "Then he laughed."
 },
 {
  "i": 309,
  "start": 539.8,
  "end": 540.34,
  "text": "Churros?"
 },
 {
  "i": 310,
  "start": 540.6,
  "end": 541.1,
  "text": "He asked."
 },
 {
  "i": 311,
  "start": 541.54,
  "end": 542.02,
  "text": "You nodded."
 },
 {
  "i": 312,
  "start": 542.44,
  "end": 542.86,
  "text": "That's all."
 },
 {
  "i": 313,
  "start": 543.36,
  "end": 545.78,
  "text": "And it was the best conversation you've ever had."
 },
 {
  "i": 314,
  "start": 546.16,
  "end": 547.66,
  "text": "Thursday, 9 p .m."
 },
 {
  "i": 315,
  "start": 548.1,
  "end": 548.82,
  "text": "Your phone rings."
 },
 {
  "i": 316,
  "start": 549.32,
  "end": 550.34,
  "text": "Leo is out of breath."
 },
 {
  "i": 317,
  "start": 550.86,
  "end": 552.3,
  "text": "Max, I met a scout."
 },
 {
  "i": 318,
  "start": 552.88,
  "end": 553.14,
  "text": "Mr."
 },
 {
  "i": 319,
  "start": 553.3,
  "end": 553.46,
  "text": "Black."
 },
 {
  "i": 320,
  "start": 553.88,
  "end": 554.56,
  "text": "Big club."
 },
 {
  "i": 321,
  "start": 554.88,
  "end": 555.7,
  "text": "He saw me play."
 },
 {
  "i": 322,
  "start": 556.3,
  "end": 557.24,
  "text": "Your stomach drops."
 },
 {
  "i": 323,
  "start": 557.76,
  "end": 558.18,
  "text": "Slowly."
 },
 {
  "i": 324,
  "start": 558.86,
  "end": 560.5,
  "text": "Don't tell my dad, Leo adds."
 },
 {
  "i": 325,
  "start": 560.9,
  "end": 561.48,
  "text": "It's a surprise."
 },
 {
  "i": 326,
  "start": 562.04,
  "end": 563.24,
  "text": "You search for the club."
 },
 {
  "i": 327,
  "start": 563.68,
  "end": 563.98,
  "text": "Nothing."
 },
 {
  "i": 328,
  "start": 564.5,
  "end": 565.12,
  "text": "No website."
 },
 {
  "i": 329,
  "start": 565.54,
  "end": 566.28,
  "text": "No phone number."
 },
 {
  "i": 330,
  "start": 566.7,
  "end": 567.1,
  "text": "Nothing."
 },
 {
  "i": 331,
  "start": 567.76,
  "end": 569.1,
  "text": "On the bus, you rehearse."
 },
 {
  "i": 332,
  "start": 569.44,
  "end": 570.2,
  "text": "40 arguments."
 },
 {
  "i": 333,
  "start": 570.58,
  "end": 571.4,
  "text": "10 answers each."
 },
 {
  "i": 334,
  "start": 571.82,
  "end": 573.92,
  "text": "You've never prepared for anything in your life."
 },
 {
  "i": 335,
  "start": 574.34,
  "end": 575.2,
  "text": "You've never needed to."
 },
 {
  "i": 336,
  "start": 575.86,
  "end": 577.52,
  "text": "Saturday, a hotel lobby."
 },
 {
  "i": 337,
  "start": 578.02,
  "end": 578.22,
  "text": "Mr."
 },
 {
  "i": 338,
  "start": 578.4,
  "end": 580.58,
  "text": "Black wears a gray suit and a perfect smile."
 },
 {
  "i": 339,
  "start": 581.04,
  "end": 582.32,
  "text": "A black car waits outside."
 },
 {
  "i": 340,
  "start": 582.9,
  "end": 583.8,
  "text": "The engine is running."
 },
 {
  "i": 341,
  "start": 584.34,
  "end": 585.62,
  "text": "Leo sits across from him."
 },
 {
  "i": 342,
  "start": 586.0,
  "end": 587.42,
  "text": "On the table lies an envelope."
 },
 {
  "i": 343,
  "start": 587.42,
  "end": 588.8,
  "text": "In his dad's handwriting."
 },
 {
  "i": 344,
  "start": 589.32,
  "end": 590.32,
  "text": "For Leo's future."
 },
 {
  "i": 345,
  "start": 590.84,
  "end": 592.2,
  "text": "Four years of night shifts."
 },
 {
  "i": 346,
  "start": 592.7,
  "end": 593.22,
  "text": "All of it."
 },
 {
  "i": 347,
  "start": 593.66,
  "end": 594.98,
  "text": "He opens a glossy folder."
 },
 {
  "i": 348,
  "start": 595.38,
  "end": 596.02,
  "text": "A club crest."
 },
 {
  "i": 349,
  "start": 596.44,
  "end": 596.84,
  "text": "A signature."
 },
 {
  "i": 350,
  "start": 597.36,
  "end": 598.38,
  "text": "A photo of a stadium."
 },
 {
  "i": 351,
  "start": 598.96,
  "end": 600.44,
  "text": "You notice the crest is blurry."
 },
 {
  "i": 352,
  "start": 600.82,
  "end": 601.84,
  "text": "Pixelated at the edges."
 },
 {
  "i": 353,
  "start": 602.44,
  "end": 603.92,
  "text": "Just a draft, says Mr."
 },
 {
  "i": 354,
  "start": 604.04,
  "end": 604.16,
  "text": "Black."
 },
 {
  "i": 355,
  "start": 604.54,
  "end": 606.0,
  "text": "Just a registration fee, son."
 },
 {
  "i": 356,
  "start": 606.48,
  "end": 607.52,
  "text": "Then a flight tonight."
 },
 {
  "i": 357,
  "start": 608.02,
  "end": 608.48,
  "text": "A trial."
 },
 {
  "i": 358,
  "start": 608.9,
  "end": 609.34,
  "text": "A contract."
 },
 {
  "i": 359,
  "start": 609.94,
  "end": 611.22,
  "text": "You listen for 10 seconds."
 },
 {
  "i": 360,
  "start": 611.64,
  "end": 612.74,
  "text": "You find five holes."
 },
 {
  "i": 361,
  "start": 612.74,
  "end": 613.94,
  "text": "No club name."
 },
 {
  "i": 362,
  "start": 614.3,
  "end": 614.82,
  "text": "No website."
 },
 {
  "i": 363,
  "start": 615.18,
  "end": 615.86,
  "text": "Cash only."
 },
 {
  "i": 364,
  "start": 616.2,
  "end": 616.8,
  "text": "Today only."
 },
 {
  "i": 365,
  "start": 617.22,
  "end": 617.96,
  "text": "Tell no one."
 },
 {
  "i": 366,
  "start": 618.4,
  "end": 620.66,
  "text": "You say all five in 30 seconds."
 },
 {
  "i": 367,
  "start": 621.12,
  "end": 621.48,
  "text": "Calm."
 },
 {
  "i": 368,
  "start": 621.94,
  "end": 622.28,
  "text": "Perfect."
 },
 {
  "i": 369,
  "start": 622.86,
  "end": 624.32,
  "text": "A waiter freezes with a tray."
 },
 {
  "i": 370,
  "start": 624.78,
  "end": 626.92,
  "text": "A woman at the next table stops mid -sip."
 },
 {
  "i": 371,
  "start": 627.32,
  "end": 628.98,
  "text": "Nobody in the lobby breathes."
 },
 {
  "i": 372,
  "start": 629.32,
  "end": 629.56,
  "text": "Mr."
 },
 {
  "i": 373,
  "start": 629.72,
  "end": 630.68,
  "text": "Black opens his mouth."
 },
 {
  "i": 374,
  "start": 631.22,
  "end": 632.04,
  "text": "Nothing comes out."
 },
 {
  "i": 375,
  "start": 632.5,
  "end": 633.16,
  "text": "He tries again."
 },
 {
  "i": 376,
  "start": 633.7,
  "end": 633.98,
  "text": "Nothing."
 },
 {
  "i": 377,
  "start": 634.5,
  "end": 635.52,
  "text": "Then he smiles."
 },
 {
  "i": 378,
  "start": 636.16,
  "end": 638.06,
  "text": "Other scouts are watching, he tells Leo."
 },
 {
  "i": 379,
  "start": 638.42,
  "end": 639.7,
  "text": "If you wait, they'll go."
 },
 {
  "i": 380,
  "start": 640.1,
  "end": 641.96,
  "text": "And somebody will try to talk you out of this."
 },
 {
  "i": 381,
  "start": 641.96,
  "end": 643.44,
  "text": "Probably someone jealous."
 },
 {
  "i": 382,
  "start": 644.06,
  "end": 645.14,
  "text": "Leo turns to you."
 },
 {
  "i": 383,
  "start": 645.4,
  "end": 645.82,
  "text": "Slowly."
 },
 {
  "i": 384,
  "start": 646.48,
  "end": 647.72,
  "text": "He said you'd say this."
 },
 {
  "i": 385,
  "start": 648.0,
  "end": 648.56,
  "text": "Leo whispers."
 },
 {
  "i": 386,
  "start": 649.14,
  "end": 650.58,
  "text": "Your stomach turns to ice."
 },
 {
  "i": 387,
  "start": 651.14,
  "end": 652.02,
  "text": "He saw you coming."
 },
 {
  "i": 388,
  "start": 652.56,
  "end": 655.92,
  "text": "Every argument you build is already inside his story."
 },
 {
  "i": 389,
  "start": 656.38,
  "end": 658.78,
  "text": "You're right, Leo says, about everything."
 },
 {
  "i": 390,
  "start": 659.4,
  "end": 659.82,
  "text": "You exhale."
 },
 {
  "i": 391,
  "start": 660.46,
  "end": 661.96,
  "text": "Then Leo picks up the pen."
 },
 {
  "i": 392,
  "start": 662.46,
  "end": 662.74,
  "text": "What?"
 },
 {
  "i": 393,
  "start": 663.12,
  "end": 663.44,
  "text": "Why?"
 },
 {
  "i": 394,
  "start": 664.0,
  "end": 664.6,
  "text": "You won!"
 },
 {
  "i": 395,
  "start": 665.1,
  "end": 666.32,
  "text": "Leo's eyes are wet."
 },
 {
  "i": 396,
  "start": 666.66,
  "end": 668.56,
  "text": "Because if you're right, it's gone."
 },
 {
  "i": 397,
  "start": 669.08,
  "end": 669.6,
  "text": "His dream."
 },
 {
  "i": 398,
  "start": 669.6,
  "end": 670.56,
  "text": "His boots."
 },
 {
  "i": 399,
  "start": 671.14,
  "end": 671.86,
  "text": "His dad's face."
 },
 {
  "i": 400,
  "start": 672.52,
  "end": 673.96,
  "text": "Leo doesn't need you to be right."
 },
 {
  "i": 401,
  "start": 674.3,
  "end": 675.64,
  "text": "He needs this to be true."
 },
 {
  "i": 402,
  "start": 676.0,
  "end": 676.78,
  "text": "That's the rule."
 },
 {
  "i": 403,
  "start": 677.14,
  "end": 677.84,
  "text": "The one you forgot."
 },
 {
  "i": 404,
  "start": 678.42,
  "end": 680.7,
  "text": "Leo's hand is 40 centimeters from the paper."
 },
 {
  "i": 405,
  "start": 681.16,
  "end": 683.16,
  "text": "A nervous reach takes about two seconds."
 },
 {
  "i": 406,
  "start": 683.66,
  "end": 685.3,
  "text": "Two seconds is five words."
 },
 {
  "i": 407,
  "start": 685.78,
  "end": 687.16,
  "text": "You have a thousand arguments."
 },
 {
  "i": 408,
  "start": 687.56,
  "end": 688.6,
  "text": "Not one fits."
 },
 {
  "i": 409,
  "start": 689.3,
  "end": 689.96,
  "text": "30 centimeters."
 },
 {
  "i": 410,
  "start": 690.64,
  "end": 690.86,
  "text": "Mr."
 },
 {
  "i": 411,
  "start": 691.04,
  "end": 692.4,
  "text": "Black slides the page closer."
 },
 {
  "i": 412,
  "start": 692.94,
  "end": 693.24,
  "text": "20."
 },
 {
  "i": 413,
  "start": 693.74,
  "end": 694.7,
  "text": "The engine hums."
 },
 {
  "i": 414,
  "start": 695.02,
  "end": 696.12,
  "text": "The flight leaves at 8."
 },
 {
  "i": 415,
  "start": 696.12,
  "end": 696.78,
  "text": "10."
 },
 {
  "i": 416,
  "start": 697.34,
  "end": 699.52,
  "text": "Win the point or keep your best friend."
 },
 {
  "i": 417,
  "start": 700.02,
  "end": 700.58,
  "text": "You let go."
 },
 {
  "i": 418,
  "start": 700.92,
  "end": 702.18,
  "text": "Your arguments fall away."
 },
 {
  "i": 419,
  "start": 702.52,
  "end": 703.18,
  "text": "Every fact."
 },
 {
  "i": 420,
  "start": 703.52,
  "end": 704.14,
  "text": "Every number."
 },
 {
  "i": 421,
  "start": 704.5,
  "end": 705.76,
  "text": "And you say five words."
 },
 {
  "i": 422,
  "start": 706.2,
  "end": 706.68,
  "text": "You win."
 },
 {
  "i": 423,
  "start": 707.22,
  "end": 707.94,
  "text": "I hate it."
 },
 {
  "i": 424,
  "start": 708.32,
  "end": 709.44,
  "text": "The lobby goes silent."
 },
 {
  "i": 425,
  "start": 709.86,
  "end": 711.14,
  "text": "A waiter lowers his tray."
 },
 {
  "i": 426,
  "start": 711.64,
  "end": 712.46,
  "text": "Leo freezes."
 },
 {
  "i": 427,
  "start": 712.92,
  "end": 713.7,
  "text": "The pen stops."
 },
 {
  "i": 428,
  "start": 714.2,
  "end": 715.68,
  "text": "Three centimeters above the paper."
 },
 {
  "i": 429,
  "start": 716.04,
  "end": 717.32,
  "text": "Because that's his line."
 },
 {
  "i": 430,
  "start": 717.74,
  "end": 718.58,
  "text": "The loser's line."
 },
 {
  "i": 431,
  "start": 718.96,
  "end": 720.04,
  "text": "And you just said it."
 },
 {
  "i": 432,
  "start": 720.3,
  "end": 720.88,
  "text": "On purpose."
 },
 {
  "i": 433,
  "start": 721.4,
  "end": 721.8,
  "text": "To him."
 },
 {
  "i": 434,
  "start": 722.28,
  "end": 724.02,
  "text": "How long has it been since you lost?"
 },
 {
  "i": 435,
  "start": 724.02,
  "end": 725.56,
  "text": "Leo looks at you."
 },
 {
  "i": 436,
  "start": 726.02,
  "end": 726.86,
  "text": "Really looks."
 },
 {
  "i": 437,
  "start": 727.5,
  "end": 727.78,
  "text": "Max?"
 },
 {
  "i": 438,
  "start": 728.34,
  "end": 729.34,
  "text": "You never lose."
 },
 {
  "i": 439,
  "start": 729.82,
  "end": 730.3,
  "text": "For me?"
 },
 {
  "i": 440,
  "start": 730.76,
  "end": 731.26,
  "text": "He whispers."
 },
 {
  "i": 441,
  "start": 731.92,
  "end": 732.4,
  "text": "For you."
 },
 {
  "i": 442,
  "start": 732.86,
  "end": 733.24,
  "text": "You say."
 },
 {
  "i": 443,
  "start": 733.8,
  "end": 735.02,
  "text": "Then your voice shakes."
 },
 {
  "i": 444,
  "start": 735.62,
  "end": 736.24,
  "text": "I'm scared."
 },
 {
  "i": 445,
  "start": 736.76,
  "end": 737.4,
  "text": "Not of him."
 },
 {
  "i": 446,
  "start": 737.88,
  "end": 738.74,
  "text": "Of losing you."
 },
 {
  "i": 447,
  "start": 739.24,
  "end": 740.48,
  "text": "I don't have a better argument."
 },
 {
  "i": 448,
  "start": 740.94,
  "end": 743.86,
  "text": "I only know real scouts never ask for money first."
 },
 {
  "i": 449,
  "start": 744.44,
  "end": 745.64,
  "text": "It's not a perfect sentence."
 },
 {
  "i": 450,
  "start": 746.12,
  "end": 747.32,
  "text": "It's not even a good one."
 },
 {
  "i": 451,
  "start": 747.62,
  "end": 749.32,
  "text": "But Leo hears every word."
 },
 {
  "i": 452,
  "start": 749.8,
  "end": 751.32,
  "text": "The pen slips from his fingers."
 },
 {
  "i": 453,
  "start": 751.32,
  "end": 752.9,
  "text": "It rolls off the table."
 },
 {
  "i": 454,
  "start": 753.46,
  "end": 754.9,
  "text": "Leo laughs through his tears."
 },
 {
  "i": 455,
  "start": 755.48,
  "end": 756.82,
  "text": "You really hate it."
 },
 {
  "i": 456,
  "start": 757.02,
  "end": 757.46,
  "text": "He says."
 },
 {
  "i": 457,
  "start": 758.22,
  "end": 758.74,
  "text": "So much."
 },
 {
  "i": 458,
  "start": 759.14,
  "end": 759.5,
  "text": "You say."
 },
 {
  "i": 459,
  "start": 760.18,
  "end": 760.18,
  "text": "Mr."
 },
 {
  "i": 460,
  "start": 760.34,
  "end": 760.92,
  "text": "Black stands."
 },
 {
  "i": 461,
  "start": 761.4,
  "end": 762.34,
  "text": "Smoothes his tie."
 },
 {
  "i": 462,
  "start": 762.82,
  "end": 763.34,
  "text": "Walks out."
 },
 {
  "i": 463,
  "start": 763.82,
  "end": 765.26,
  "text": "The black car drives away."
 },
 {
  "i": 464,
  "start": 765.64,
  "end": 766.7,
  "text": "With an empty seat."
 },
 {
  "i": 465,
  "start": 767.22,
  "end": 767.96,
  "text": "You could chase him."
 },
 {
  "i": 466,
  "start": 768.42,
  "end": 769.72,
  "text": "Ruin his name in an hour."
 },
 {
  "i": 467,
  "start": 770.18,
  "end": 772.72,
  "text": "But then you'd just be another man who needs to win."
 },
 {
  "i": 468,
  "start": 773.14,
  "end": 778.0,
  "text": "Instead, the hotel manager, who heard everything, picks up the phone and calls the police."
 },
 {
  "i": 469,
  "start": 778.0,
  "end": 779.68,
  "text": "Leo calls his dad."
 },
 {
  "i": 470,
  "start": 780.06,
  "end": 782.38,
  "text": "Ten minutes later, he arrives in his work boots."
 },
 {
  "i": 471,
  "start": 782.8,
  "end": 783.72,
  "text": "He sees the envelope."
 },
 {
  "i": 472,
  "start": 784.22,
  "end": 785.78,
  "text": "He sits down on the lobby floor."
 },
 {
  "i": 473,
  "start": 786.26,
  "end": 787.4,
  "text": "He doesn't say a word."
 },
 {
  "i": 474,
  "start": 787.82,
  "end": 789.18,
  "text": "He just holds his son."
 },
 {
  "i": 475,
  "start": 789.66,
  "end": 793.44,
  "text": "A week later, the police find a drawer full of envelopes just like it."
 },
 {
  "i": 476,
  "start": 793.8,
  "end": 796.04,
  "text": "Nobody in that lobby forgets what they saw."
 },
 {
  "i": 477,
  "start": 796.5,
  "end": 798.64,
  "text": "That night, Leo's dad hugs you too."
 },
 {
  "i": 478,
  "start": 799.04,
  "end": 800.82,
  "text": "He smells like cardboard and coffee."
 },
 {
  "i": 479,
  "start": 801.28,
  "end": 802.34,
  "text": "He doesn't say thank you."
 },
 {
  "i": 480,
  "start": 802.7,
  "end": 804.6,
  "text": "He says, You're welcome at our table."
 },
 {
  "i": 481,
  "start": 804.92,
  "end": 805.28,
  "text": "Always."
 },
 {
  "i": 482,
  "start": 805.84,
  "end": 809.02,
  "text": "Soon after, a real club offers Leo a free trial."
 },
 {
  "i": 483,
  "start": 809.5,
  "end": 809.76,
  "text": "Free."
 },
 {
  "i": 484,
  "start": 810.36,
  "end": 812.82,
  "text": "At home, your mom says you're wrong about the garage."
 },
 {
  "i": 485,
  "start": 813.34,
  "end": 813.76,
  "text": "You grin."
 },
 {
  "i": 486,
  "start": 814.26,
  "end": 814.52,
  "text": "Wrong?"
 },
 {
  "i": 487,
  "start": 814.9,
  "end": 815.3,
  "text": "Explain."
 },
 {
  "i": 488,
  "start": 815.88,
  "end": 816.4,
  "text": "And she does."
 },
 {
  "i": 489,
  "start": 816.9,
  "end": 819.36,
  "text": "For an hour, you lose every point."
 },
 {
  "i": 490,
  "start": 819.68,
  "end": 823.02,
  "text": "And somewhere around the fifth, something lights up in your chest."
 },
 {
  "i": 491,
  "start": 823.48,
  "end": 823.74,
  "text": "Tiny."
 },
 {
  "i": 492,
  "start": 824.28,
  "end": 824.54,
  "text": "Warm."
 },
 {
  "i": 493,
  "start": 825.08,
  "end": 825.5,
  "text": "A spark."
 },
 {
  "i": 494,
  "start": 826.06,
  "end": 827.4,
  "text": "You laugh right on time."
 },
 {
  "i": 495,
  "start": 827.8,
  "end": 828.62,
  "text": "You can win a point."
 },
 {
  "i": 496,
  "start": 829.0,
  "end": 830.58,
  "text": "But a point isn't a person."
 },
 {
  "i": 497,
  "start": 830.58,
  "end": 833.14,
  "text": "Saturday, Leo buys the churros."
 },
 {
  "i": 498,
  "start": 833.5,
  "end": 835.08,
  "text": "That night, your phone buzzes."
 },
 {
  "i": 499,
  "start": 835.36,
  "end": 836.12,
  "text": "Unknown number."
 },
 {
  "i": 500,
  "start": 836.48,
  "end": 837.04,
  "text": "One message."
 },
 {
  "i": 501,
  "start": 837.6,
  "end": 838.06,
  "text": "Impressive."
 },
 {
  "i": 502,
  "start": 838.52,
  "end": 840.86,
  "text": "I know someone who has never lost an argument either."
 },
 {
  "i": 503,
  "start": 841.32,
  "end": 841.74,
  "text": "A pause."
 },
 {
  "i": 504,
  "start": 842.2,
  "end": 843.32,
  "text": "Then a second message."
 },
 {
  "i": 505,
  "start": 843.8,
  "end": 844.74,
  "text": "Her name is Nova."
 },
 {
  "i": 506,
  "start": 845.14,
  "end": 846.0,
  "text": "She'd like to meet you."
 },
 {
  "i": 507,
  "start": 846.42,
  "end": 847.52,
  "text": "So what's real?"
 },
 {
  "i": 508,
  "start": 848.02,
  "end": 849.66,
  "text": "Nobody wins every argument."
 },
 {
  "i": 509,
  "start": 850.08,
  "end": 851.24,
  "text": "Winning needs a judge."
 },
 {
  "i": 510,
  "start": 851.56,
  "end": 853.62,
  "text": "And the judge is always a person."
 },
 {
  "i": 511,
  "start": 854.04,
  "end": 861.54,
  "text": "In 2011, Hugo Mercier and Dan Sperber argued that human reasoning evolved partly to persuade others and to judge their arguments."
 },
 {
  "i": 512,
  "start": 862.02,
  "end": 863.54,
  "text": "But a brain that always wins?"
 },
 {
  "i": 513,
  "start": 864.02,
  "end": 864.66,
  "text": "Pure fiction."
 },
 {
  "i": 514,
  "start": 865.24,
  "end": 866.52,
  "text": "The cost is half real."
 },
 {
  "i": 515,
  "start": 866.88,
  "end": 869.62,
  "text": "Your brain really does burn about 20 % of your energy."
 },
 {
  "i": 516,
  "start": 870.04,
  "end": 871.52,
  "text": "The starving part is exaggerated."
 },
 {
  "i": 517,
  "start": 872.18,
  "end": 873.66,
  "text": "The dopamine part is real."
 },
 {
  "i": 518,
  "start": 874.08,
  "end": 877.36,
  "text": "In the 90s, Wolfram Schultz recorded dopamine cells in monkeys."
 },
 {
  "i": 519,
  "start": 877.82,
  "end": 880.48,
  "text": "They fire most when a reward is better than expected."
 },
 {
  "i": 520,
  "start": 880.96,
  "end": 882.64,
  "text": "The speed is real, in part."
 },
 {
  "i": 521,
  "start": 883.04,
  "end": 888.7,
  "text": "In 2001, Nelson Cowan estimated that working memory holds about four items, not 40."
 },
 {
  "i": 522,
  "start": 889.06,
  "end": 894.38,
  "text": "And a 2009 study of 10 languages found people reply in about 200 milliseconds."
 },
 {
  "i": 523,
  "start": 894.74,
  "end": 897.98,
  "text": "Fast enough that they start planning before the other person finishes."
 },
 {
  "i": 524,
  "start": 898.76,
  "end": 899.58,
  "text": "Now, facts."
 },
 {
  "i": 525,
  "start": 900.3,
  "end": 903.72,
  "text": "Scientists once worried that corrections make people dig in harder."
 },
 {
  "i": 526,
  "start": 904.16,
  "end": 905.22,
  "text": "The backfire effect."
 },
 {
  "i": 527,
  "start": 905.66,
  "end": 910.2,
  "text": "But a 2019 study by Thomas Wood and Ethan Porter found it's actually rare."
 },
 {
  "i": 528,
  "start": 910.62,
  "end": 912.14,
  "text": "People can change their minds."
 },
 {
  "i": 529,
  "start": 912.46,
  "end": 913.4,
  "text": "Just slowly."
 },
 {
  "i": 530,
  "start": 913.78,
  "end": 915.58,
  "text": "And more easily when they feel heard."
 },
 {
  "i": 531,
  "start": 915.58,
  "end": 917.98,
  "text": "And one lesson from this story is real."
 },
 {
  "i": 532,
  "start": 918.42,
  "end": 921.88,
  "text": "If someone says, pay today and tell no one, walk away."
 },
 {
  "i": 533,
  "start": 922.48,
  "end": 924.1,
  "text": "So what really changes a mind?"
 },
 {
  "i": 534,
  "start": 924.6,
  "end": 926.36,
  "text": "Being right or being heard?"
 },
 {
  "i": 535,
  "start": 926.9,
  "end": 927.44,
  "text": "What do you think?"
 },
 {
  "i": 536,
  "start": 927.88,
  "end": 930.46,
  "text": "Tell us in the comments which argument you'd win first."
 },
 {
  "i": 537,
  "start": 930.9,
  "end": 933.12,
  "text": "Tell us the worst argument you ever lost."
 },
 {
  "i": 538,
  "start": 933.46,
  "end": 934.7,
  "text": "We promise not to win it."
 },
 {
  "i": 539,
  "start": 935.02,
  "end": 937.1,
  "text": "And tell us which superpower we should do next."
 },
 {
  "i": 540,
  "start": 937.54,
  "end": 942.66,
  "text": "And if your heart skipped when Max said those five words, hit like and subscribe for part two."
 }
]